<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PneumaticCoreTest" Id="{d4c45ca2-0b7e-45de-bf78-6c2831012df3}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests of the behaviour FB_PneumaticActuator and FB_MPA share: the position state from the limit
   switches and the output timeout. Each test calls the body, the way a block does. *)
{attribute 'analysis' := '-33'}
FUNCTION_BLOCK FB_PneumaticCoreTest EXTENDS FB_TestSuite
VAR
    fbSutTimeout : FB_PneumaticCore;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[GivenLimitSwitchCombinationsThenStateIsDerived();
GivenOutputOnWithoutLimitSwitchThenTimeoutIsReported();]]></ST>
    </Implementation>
    <Method Name="GivenLimitSwitchCombinationsThenStateIsDerived" Id="{021d6aee-cfd3-4b5e-bf99-455dc34939c2}">
      <Declaration><![CDATA[(* Both active is INVALID, only out is RETRACTED, only in is INSERTED, neither is MOVING. *)
METHOD PRIVATE GivenLimitSwitchCombinationsThenStateIsDerived
VAR
    fbSut : FB_PneumaticCore;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST(__POUNAME());

fbSut(bInLimitSwitch := TRUE, bOutLimitSwitch := TRUE, bInsertOutput := FALSE, bRetractOutput := FALSE, tTimeout := T#1S);
AssertTrue(
    Condition := fbSut.eState = E_PnuematicActuatorPositionState.INVALID,
    Message := 'Both limit switches must give INVALID');
fbSut(bInLimitSwitch := FALSE, bOutLimitSwitch := TRUE, bInsertOutput := FALSE, bRetractOutput := FALSE, tTimeout := T#1S);
AssertTrue(
    Condition := fbSut.eState = E_PnuematicActuatorPositionState.RETRACTED,
    Message := 'Out limit switch only must give RETRACTED');
fbSut(bInLimitSwitch := TRUE, bOutLimitSwitch := FALSE, bInsertOutput := FALSE, bRetractOutput := FALSE, tTimeout := T#1S);
AssertTrue(
    Condition := fbSut.eState = E_PnuematicActuatorPositionState.INSERTED,
    Message := 'In limit switch only must give INSERTED');
fbSut(bInLimitSwitch := FALSE, bOutLimitSwitch := FALSE, bInsertOutput := FALSE, bRetractOutput := FALSE, tTimeout := T#1S);
AssertTrue(
    Condition := fbSut.eState = E_PnuematicActuatorPositionState.MOVING,
    Message := 'Neither limit switch must give MOVING');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="GivenOutputOnWithoutLimitSwitchThenTimeoutIsReported" Id="{857cedba-c50e-44b0-8f8d-bb50c534fa4e}">
      <Declaration><![CDATA[(* An output on without its limit switch times out. The limit switch of that direction ends the
   report. An output that is off never times out. *)
METHOD PRIVATE GivenOutputOnWithoutLimitSwitchThenTimeoutIsReported
VAR_INST
    nStep : INT;
    fbWait : TON;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST(__POUNAME());

CASE nStep OF
    0:
        nStep := 1;

    1:
        IF fbWait.Q THEN
            AssertTrue(Condition := fbSutTimeout.bInsertTimedOut, Message := 'Insert output without limit switch must time out');
            AssertTrue(Condition := fbSutTimeout.InsertTimeoutElapsed, Message := 'Insert timer must have elapsed');
            AssertFalse(Condition := fbSutTimeout.bRetractTimedOut, Message := 'Retract output is off and must not time out');
            AssertFalse(Condition := fbSutTimeout.RetractTimeoutElapsed, Message := 'Retract timer must not have elapsed');
            nStep := 2;
        END_IF

    2:
        fbSutTimeout(
            bInLimitSwitch := TRUE,
            bOutLimitSwitch := FALSE,
            bInsertOutput := TRUE,
            bRetractOutput := FALSE,
            tTimeout := T#20MS);
        AssertFalse(Condition := fbSutTimeout.bInsertTimedOut, Message := 'Reaching the limit switch must end the timeout report');
        nStep := 3;
END_CASE

IF nStep < 2 THEN
    fbSutTimeout(
        bInLimitSwitch := FALSE,
        bOutLimitSwitch := FALSE,
        bInsertOutput := TRUE,
        bRetractOutput := FALSE,
        tTimeout := T#20MS);
END_IF
fbWait(IN := nStep = 1, PT := T#200MS);

IF nStep = 3 THEN
    TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>