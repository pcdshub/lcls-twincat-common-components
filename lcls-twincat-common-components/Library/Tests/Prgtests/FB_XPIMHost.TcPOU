<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_XPIMHost" Id="{b5663ae7-9f1f-40ed-9fb9-04e5252f17b6}" SpecialFunc="None">
    <Declaration><![CDATA[(* Test host that nests an FB_XPIM, the way a device FB would. Its references and
   values are bound in its own FB_Init, which runs after the nested FB_XPIM was
   constructed from them, so the nested FB_XPIM first sees nil references and
   empty values. CallAfterInit re-supplies all of them through
   fbXPIM.CallAfterInitXPIM. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_XPIMHost
VAR
    {attribute 'no_copy'}
    aiMotionStage         : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    {attribute 'no_copy'}
    astPositionState      : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    {attribute 'no_copy'}
    fbFFHWO               : REFERENCE TO FB_HardwareFFOutput;
    {attribute 'no_copy'}
    fbArbiter             : REFERENCE TO FB_Arbiter;
    sDeviceName           : STRING;
    sTransitionKey        : STRING;
    bEnableBeamParams     : BOOL;
    bEnablePositionLimits : BOOL;
    bReadDBNow            : BOOL;
    {attribute 'no_copy'}
    bFileReaderBusy       : REFERENCE TO BOOL;
    {attribute 'no_copy'}
    bFileReaderError      : REFERENCE TO BOOL;
    {attribute 'no_copy'}
    stEl6In : REFERENCE TO EL6inData22b;
    {attribute 'no_copy'}
    stEl6Out : REFERENCE TO EL6outData22b;

    fbXPIM : FB_XPIM(
        aiMotionStage         := aiMotionStage,
        astPositionState      := astPositionState,
        fbFFHWO               := fbFFHWO,
        fbArbiter             := fbArbiter,
        sDeviceName           := sDeviceName,
        sTransitionKey        := sTransitionKey,
        bEnableBeamParams     := bEnableBeamParams,
        bEnablePositionLimits := bEnablePositionLimits,
        bReadDBNow            := bReadDBNow,
        bFileReaderBusy       := bFileReaderBusy,
        bFileReaderError      := bFileReaderError,
        stEl6In               := stEl6In,
        stEl6Out              := stEl6Out
    );
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbXPIM();
]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{0f87f1aa-f7ac-44d2-9b9a-a343b4c3940c}">
      <Declaration><![CDATA[(* The nested fbXPIM ran its own CallAfterInit before this one, with nil
   references. Re-supplies them and redoes its wiring. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbXPIM.CallAfterInitXPIM(
    aiMotionStage         := aiMotionStage,
    astPositionState      := astPositionState,
    fbFFHWO               := fbFFHWO,
    fbArbiter             := fbArbiter,
    sDeviceName           := sDeviceName,
    sTransitionKey        := sTransitionKey,
    bEnableBeamParams     := bEnableBeamParams,
    bEnablePositionLimits := bEnablePositionLimits,
    bReadDBNow            := bReadDBNow,
    bFileReaderBusy       := bFileReaderBusy,
    bFileReaderError      := bFileReaderError,
    stEl6In               := stEl6In,
    stEl6Out              := stEl6Out
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{66234f54-ee62-4baa-ac9d-feaa1b663226}">
      <Declaration><![CDATA[(* Stores the injected references and values in this FB's fields. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains           : BOOL;
    bInCopyCode            : BOOL;
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
    stEl6In                : REFERENCE TO EL6inData22b;
    stEl6Out               : REFERENCE TO EL6outData22b;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.aiMotionStage         REF= aiMotionStage;
THIS^.astPositionState      REF= astPositionState;
THIS^.fbFFHWO               REF= fbFFHWO;
THIS^.fbArbiter             REF= fbArbiter;
THIS^.sDeviceName           := sDeviceName;
THIS^.sTransitionKey        := sTransitionKey;
THIS^.bEnableBeamParams     := bEnableBeamParams;
THIS^.bEnablePositionLimits := bEnablePositionLimits;
THIS^.bReadDBNow            := bReadDBNow;
THIS^.bFileReaderBusy       REF= bFileReaderBusy;
THIS^.bFileReaderError      REF= bFileReaderError;
THIS^.stEl6In REF= stEl6In;
THIS^.stEl6Out REF= stEl6Out;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>