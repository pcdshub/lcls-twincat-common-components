<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_IPMHost" Id="{c00050ac-05e0-44b3-a689-765a78110328}" SpecialFunc="None">
    <Declaration><![CDATA[(* Test host that nests an FB_IPM, the way a device FB would. Its references and
   values are bound in its own FB_Init, which runs after the nested FB_IPM was
   constructed from them, so the nested FB_IPM first sees nil references and
   empty values. CallAfterInit re-supplies all of them through
   fbIPM.CallAfterInitIPM. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_IPMHost
VAR
    {attribute 'no_copy'}
    aiMotionStage         : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    {attribute 'no_copy'}
    astPositionState      : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    {attribute 'no_copy'}
    fbFFHWO               : REFERENCE TO FB_HardwareFFOutput;
    {attribute 'no_copy'}
    fbArbiter             : REFERENCE TO FB_Arbiter;
    sDeviceName           : STRING;
    sTransitionKey        : STRING;
    bEnableBeamParams     : BOOL;
    bEnablePositionLimits : BOOL;
    bReadDBNow            : BOOL;
    {attribute 'no_copy'}
    bFileReaderBusy       : REFERENCE TO BOOL;
    {attribute 'no_copy'}
    bFileReaderError      : REFERENCE TO BOOL;

    fbIPM : FB_IPM(
        aiMotionStage         := aiMotionStage,
        astPositionState      := astPositionState,
        fbFFHWO               := fbFFHWO,
        fbArbiter             := fbArbiter,
        sDeviceName           := sDeviceName,
        sTransitionKey        := sTransitionKey,
        bEnableBeamParams     := bEnableBeamParams,
        bEnablePositionLimits := bEnablePositionLimits,
        bReadDBNow            := bReadDBNow,
        bFileReaderBusy       := bFileReaderBusy,
        bFileReaderError      := bFileReaderError
    );
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbIPM();
]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{99d392ce-3032-4cbc-a147-d61cc73e09ab}">
      <Declaration><![CDATA[(* The nested fbIPM ran its own CallAfterInit before this one, with nil
   references. Re-supplies them and redoes its wiring. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbIPM.CallAfterInitIPM(
    aiMotionStage         := aiMotionStage,
    astPositionState      := astPositionState,
    fbFFHWO               := fbFFHWO,
    fbArbiter             := fbArbiter,
    sDeviceName           := sDeviceName,
    sTransitionKey        := sTransitionKey,
    bEnableBeamParams     := bEnableBeamParams,
    bEnablePositionLimits := bEnablePositionLimits,
    bReadDBNow            := bReadDBNow,
    bFileReaderBusy       := bFileReaderBusy,
    bFileReaderError      := bFileReaderError
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{acc1435e-f168-4534-ae67-5dc7463214c9}">
      <Declaration><![CDATA[(* Stores the injected references and values in this FB's fields. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains           : BOOL;
    bInCopyCode            : BOOL;
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.aiMotionStage         REF= aiMotionStage;
THIS^.astPositionState      REF= astPositionState;
THIS^.fbFFHWO               REF= fbFFHWO;
THIS^.fbArbiter             REF= fbArbiter;
THIS^.sDeviceName           := sDeviceName;
THIS^.sTransitionKey        := sTransitionKey;
THIS^.bEnableBeamParams     := bEnableBeamParams;
THIS^.bEnablePositionLimits := bEnablePositionLimits;
THIS^.bReadDBNow            := bReadDBNow;
THIS^.bFileReaderBusy       REF= bFileReaderBusy;
THIS^.bFileReaderError      REF= bFileReaderError;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>