<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PPMHost" Id="{2eff5480-14f6-4006-adf7-69a06f049c3f}" SpecialFunc="None">
    <Declaration><![CDATA[(* Test host that nests an FB_PPM, the way a device FB would. Its references and
   values are bound in its own FB_Init, which runs after the nested FB_PPM was
   constructed from them, so the nested FB_PPM first sees nil references and
   empty values. CallAfterInit re-supplies all of them through
   fbPPM.CallAfterInitPPM. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_PPMHost
VAR
    {attribute 'no_copy'}
    aiMotionStage         : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    {attribute 'no_copy'}
    astPositionState      : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    {attribute 'no_copy'}
    fbFFHWO               : REFERENCE TO FB_HardwareFFOutput;
    {attribute 'no_copy'}
    fbArbiter             : REFERENCE TO FB_Arbiter;
    sDeviceName           : STRING;
    sTransitionKey        : STRING;
    bEnableBeamParams     : BOOL;
    bEnablePositionLimits : BOOL;
    bReadDBNow            : BOOL;
    {attribute 'no_copy'}
    bFileReaderBusy       : REFERENCE TO BOOL;
    {attribute 'no_copy'}
    bFileReaderError      : REFERENCE TO BOOL;
    fResponsivity : LREAL;
    iTermBits : UINT;
    fTermMax : REAL;
    fTermMin : REAL;

    fbPPM : FB_PPM(
        aiMotionStage         := aiMotionStage,
        astPositionState      := astPositionState,
        fbFFHWO               := fbFFHWO,
        fbArbiter             := fbArbiter,
        sDeviceName           := sDeviceName,
        sTransitionKey        := sTransitionKey,
        bEnableBeamParams     := bEnableBeamParams,
        bEnablePositionLimits := bEnablePositionLimits,
        bReadDBNow            := bReadDBNow,
        bFileReaderBusy       := bFileReaderBusy,
        bFileReaderError      := bFileReaderError,
        fResponsivity         := fResponsivity,
        iTermBits             := iTermBits,
        fTermMax              := fTermMax,
        fTermMin              := fTermMin
    );
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbPPM();
]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{d6da3ec4-d111-44e5-8137-ee43c012974c}">
      <Declaration><![CDATA[(* The nested fbPPM ran its own CallAfterInit before this one, with nil
   references. Re-supplies them and redoes its wiring. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbPPM.CallAfterInitPPM(
    aiMotionStage         := aiMotionStage,
    astPositionState      := astPositionState,
    fbFFHWO               := fbFFHWO,
    fbArbiter             := fbArbiter,
    sDeviceName           := sDeviceName,
    sTransitionKey        := sTransitionKey,
    bEnableBeamParams     := bEnableBeamParams,
    bEnablePositionLimits := bEnablePositionLimits,
    bReadDBNow            := bReadDBNow,
    bFileReaderBusy       := bFileReaderBusy,
    bFileReaderError      := bFileReaderError,
    fResponsivity         := fResponsivity,
    iTermBits             := iTermBits,
    fTermMax              := fTermMax,
    fTermMin              := fTermMin
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{4f5a1a73-8d18-433b-bd43-6f8afdc8196e}">
      <Declaration><![CDATA[(* Stores the injected references and values in this FB's fields. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains           : BOOL;
    bInCopyCode            : BOOL;
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
    fResponsivity          : LREAL;
    iTermBits              : UINT;
    fTermMax               : REAL;
    fTermMin               : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.aiMotionStage         REF= aiMotionStage;
THIS^.astPositionState      REF= astPositionState;
THIS^.fbFFHWO               REF= fbFFHWO;
THIS^.fbArbiter             REF= fbArbiter;
THIS^.sDeviceName           := sDeviceName;
THIS^.sTransitionKey        := sTransitionKey;
THIS^.bEnableBeamParams     := bEnableBeamParams;
THIS^.bEnablePositionLimits := bEnablePositionLimits;
THIS^.bReadDBNow            := bReadDBNow;
THIS^.bFileReaderBusy       REF= bFileReaderBusy;
THIS^.bFileReaderError      REF= bFileReaderError;
THIS^.fResponsivity := fResponsivity;
THIS^.iTermBits := iTermBits;
THIS^.fTermMax := fTermMax;
THIS^.fTermMin := fTermMin;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_PPMHost">
      <LineId Id="1" Count="1" />
    </LineIds>
    <LineIds Name="FB_PPMHost.CallAfterInit">
      <LineId Id="1" Count="17" />
    </LineIds>
    <LineIds Name="FB_PPMHost.FB_Init">
      <LineId Id="1" Count="14" />
    </LineIds>
  </POU>
</TcPlcObject>