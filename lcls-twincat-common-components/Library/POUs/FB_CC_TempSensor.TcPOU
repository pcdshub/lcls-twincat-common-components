<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_CC_TempSensor" Id="{62e52992-2558-4a9c-b1dd-b3b9616cbbcf}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CC_TempSensor EXTENDS FB_TempSensor_FFO
VAR
    rtVetoReset: R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Clear the fault on veto; bAutoReset stays FALSE.
rtVetoReset(CLK:=bVeto);
FFO.i_xReset := rtVetoReset.Q;

SUPER^(bAutoReset:=FALSE, io_fbFFHWO:=io_fbFFHWO);]]></ST>
    </Implementation>
    <Method Name="SetRawCounts" Id="{01e6c1fb-fbf7-461e-ad3d-c6b17a91ff35}">
      <Declaration><![CDATA[(* Test seam: writes the raw terminal counts that the IO link normally supplies,
   so tests drive the sensor without reaching into the base FB. *)
METHOD INTERNAL SetRawCounts
VAR_INPUT
    Counts : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.iRaw := Counts;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>