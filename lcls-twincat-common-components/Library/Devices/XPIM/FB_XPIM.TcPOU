<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_XPIM" Id="{aa9f645d-c463-4c9e-8962-8aa3b3b2b9c3}" SpecialFunc="None">
    <Declaration><![CDATA[(* XTES Profile Imager (XPIM) with the library state enum E_XPIM_States: FB_XPIM_Core plus the
   enum bridge, the per-state defaults, the LED, the filter wheel and the Opal camera. FB_Init repeats the core inputs and
   binds the bridge. An FB that nests an FB_XPIM calls CallAfterInitXPIM
   from its own CallAfterInit. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_XPIM EXTENDS FB_XPIM_Core
VAR
    (* Device-specific state-enum bridge. Typed as E_XPIM_States (UINT
       base); FB_Init binds it to the base's REFERENCE TO UINT
       bridge. EPICS owns it through the pytmc pragma; PLC code
       must go through the EnumSet property instead of touching it
       directly. *)
    // Set this to a non-unknown value to request a new move.
    {attribute 'pytmc' := '
        pv: MMS:STATE:SET
        io: io
    '}
    eEnumSet : E_XPIM_States;

    (* One configurator per XPIM state. Writes the
       per-state sName and fDelta once in its CallAfterInit, which this
       FB's CallAfterInit calls. *)
    {attribute 'pytmc' := 'pv: CIL'}
    fbLED : FB_XPIM_LED;

    {attribute 'pytmc' := 'pv: CAM'}
    fbOpal : FB_XPIM_Opal;

    (* EL6 serial terminal buffers, caller-owned and physically linked to the
       EL6xxx terminal IO. Passed to FB_XPIM_FilterWheel each cycle. *)
    {attribute 'no_copy'}
    stEl6In  : REFERENCE TO EL6inData22b;
    {attribute 'no_copy'}
    stEl6Out : REFERENCE TO EL6outData22b;

    {attribute 'pytmc' := 'pv: MFW'}
    fbFilterWheel : FB_XPIM_FilterWheel(
        stIn_EL6  := stEl6In,
        stOut_EL6 := stEl6Out
    );

    afbStateDefaults : ARRAY[1..4] OF FB_CC_InternalStateConfig[
        (stPositionState := astPositionState[1][E_XPIM_States.OUT],
         sName           := 'OUT',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_XPIM_States.YAG],
         sName           := 'YAG',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_XPIM_States.DIAMOND],
         sName           := 'DIAMOND',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_XPIM_States.RETICLE],
         sName           := 'RETICLE',
         fDelta          := FDELTA_DEFAULT)
    ];
END_VAR
VAR_OUTPUT
    // The current position state as an enum.
    {attribute 'pytmc' := '
        pv: MMS:STATE:GET
        io: i
    '}
    eEnumGet: E_XPIM_States;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT THIS^.ReferencesValid()
   AND NOT __ISVALIDREF(stEl6In)
   AND NOT __ISVALIDREF(stEl6Out) THEN
   RETURN;
END_IF

SUPER^();

fbFilterWheel(
    bExecute := TRUE
);
fbOpal();
fbLED(
    enumXPIM := eEnumGet
);]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{b4fb382e-2ad5-49fa-b065-5df93345a364}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init, together with the base CallAfterInit. Binds the
   state bridge to this FB's enum variables and initializes the states. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;

THIS^.InitStateDefaults();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitXPIM" Id="{7bc0c29e-2d18-4e8c-bed0-6028e9258f76}">
      <Declaration><![CDATA[(* Provides every FB_XPIM_Core input, binds the state bridge, initializes the
   states through InitStateDefaults and wires fbStates. FB_Init calls it with the PRG arguments. An FB
   that instantiates FB_XPIM inside itself calls it again from its own
   CallAfterInit: the nested FB's CallAfterInit runs before the host's, with
   nil references, so this method has to redo the whole wiring, base included.
   The base holds only references, so the derived type supplies them. *)
METHOD CallAfterInitXPIM
VAR_INPUT
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
    stEl6In                : REFERENCE TO EL6inData22b;
    stEl6Out               : REFERENCE TO EL6outData22b;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.aiMotionStage         REF= aiMotionStage;
SUPER^.astPositionState      REF= astPositionState;
SUPER^.fbFFHWO               REF= fbFFHWO;
SUPER^.fbArbiter             REF= fbArbiter;
SUPER^.sDeviceName           := sDeviceName;
SUPER^.sTransitionKey        := sTransitionKey;
SUPER^.bEnableBeamParams     := bEnableBeamParams;
SUPER^.bEnablePositionLimits := bEnablePositionLimits;
SUPER^.bReadDBNow            := bReadDBNow;
SUPER^.bFileReaderBusy       REF= bFileReaderBusy;
SUPER^.bFileReaderError      REF= bFileReaderError;
THIS^.stEl6In                REF= stEl6In;
THIS^.stEl6Out               REF= stEl6Out;
THIS^.fbFilterWheel.CallAfterInitFilterWheel(
    stIn_EL6  := stEl6In,
    stOut_EL6 := stEl6Out
);

SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;
//
THIS^.InitStateDefaults();
SUPER^.CallAfterInitCore();
]]></ST>
      </Implementation>
    </Method>
    <Property Name="EnumGet" Id="{e9fb9851-7f70-4da2-840a-b85ea1cf0c38}">
      <Declaration><![CDATA[(* Current position state. Read-only; written by the state mover. *)
PROPERTY EnumGet : E_XPIM_States]]></Declaration>
      <Get Name="Get" Id="{b62c8fc2-31db-4fe2-ad80-0c3e37e08213}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumGet := eEnumGet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnumSet" Id="{12602291-7990-4746-8f23-822ecd5658ce}">
      <Declaration><![CDATA[(* Request a new move, e.g. `fbXPIM.EnumSet := E_XPIM_States.YAG;`.
   The state mover consumes and clears the request. *)
PROPERTY EnumSet : E_XPIM_States]]></Declaration>
      <Get Name="Get" Id="{a7c4e6d2-3b19-4f58-9d0e-6c21b8f35a40}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumSet := eEnumSet;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{b8d5f7e3-4c2a-4a69-8e1f-7d32c9a46b51}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eEnumSet := EnumSet;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_Init" Id="{384603da-71d8-47c3-a915-1354118b9c6e}">
      <Declaration><![CDATA[(* Repeats the eleven FB_XPIM_Core inputs, as a derived FB_Init must, and
   forwards them to CallAfterInitXPIM, which provides them to the base, binds
   the state bridge and wires the states. Runs before any CallAfterInit. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains           : BOOL;
    bInCopyCode            : BOOL;
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
    stEl6In                : REFERENCE TO EL6inData22b;
    stEl6Out               : REFERENCE TO EL6outData22b;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.CallAfterInitXPIM(
    aiMotionStage         := aiMotionStage,
    astPositionState      := astPositionState,
    fbFFHWO               := fbFFHWO,
    fbArbiter             := fbArbiter,
    sDeviceName           := sDeviceName,
    sTransitionKey        := sTransitionKey,
    bEnableBeamParams     := bEnableBeamParams,
    bEnablePositionLimits := bEnablePositionLimits,
    bReadDBNow            := bReadDBNow,
    bFileReaderBusy       := bFileReaderBusy,
    bFileReaderError      := bFileReaderError,
    stEl6In               := stEl6In,
    stEl6Out              := stEl6Out
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="InitStateDefaults" Id="{561cfa4f-3353-432e-9318-407293f754b4}">
      <Declaration><![CDATA[(* Full init of every state of astPositionState: gives it its name (sName) and
   its in-position tolerance (fDelta, FDELTA_DEFAULT) by running afbStateDefaults. astPositionState belongs to the caller, so the
   configurators can only be given the slots once this FB holds the caller's
   reference, and have to run again when a host FB re-wires this one. Returns
   without writing while astPositionState is nil: a nested FB_XPIM runs its own
   CallAfterInit before its host has supplied the reference, and indexing a nil
   reference yields an address that passes __ISVALIDREF but faults on the first
   write. *)
METHOD PROTECTED InitStateDefaults
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(THIS^.astPositionState) THEN
    RETURN;
END_IF

afbStateDefaults[1].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_XPIM_States.OUT]
);
afbStateDefaults[2].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_XPIM_States.YAG]
);
afbStateDefaults[3].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_XPIM_States.DIAMOND]
);
afbStateDefaults[4].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_XPIM_States.RETICLE]
);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>