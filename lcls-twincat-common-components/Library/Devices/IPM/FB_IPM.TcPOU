<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_IPM" Id="{5686e09b-32c7-4e77-9d6e-c0baf6046a0f}" SpecialFunc="None">
    <Declaration><![CDATA[(* Intensity Position Monitor (IPM) with the library state enum E_IPM_States: FB_IPM_Core plus the
   enum bridge and the per-state defaults. FB_Init repeats the core inputs and
   binds the bridge. An FB that nests an FB_IPM calls CallAfterInitIPM
   from its own CallAfterInit. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_IPM EXTENDS FB_IPM_Core
VAR
    // Set this to a non-unknown value to request a new move.
    {attribute 'pytmc' := '
        pv: MMS:STATE:SET
        io: io
    '}
    eEnumSet : E_IPM_States;

    (* One configurator per IPM state *)
    afbStateDefaults : ARRAY[1..5] OF FB_CC_InternalStateConfig[
        (stPositionState := astPositionState[1][E_IPM_States.OUT],
         sName           := 'OUT',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_IPM_States.TARGET1],
         sName           := 'TARGET1',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_IPM_States.TARGET2],
         sName           := 'TARGET2',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_IPM_States.TARGET3],
         sName           := 'TARGET3',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_IPM_States.TARGET4],
         sName           := 'TARGET4',
         fDelta          := FDELTA_DEFAULT)
    ];
END_VAR
VAR_OUTPUT
    // The current position state as an enum.
    {attribute 'pytmc' := '
        pv: MMS:STATE:GET
        io: i
    '}
    eEnumGet: E_IPM_States;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{9da1fe66-1f4a-4554-8ad1-8a27eeb0e1dd}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init, together with the base CallAfterInit. Binds the
   state bridge to this FB's enum variables and initializes the states. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;

THIS^.InitStateDefaults();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitIPM" Id="{a1dd9a41-e934-4503-8c3e-aecc5c3611cd}">
      <Declaration><![CDATA[(* Provides every FB_IPM_Core input, binds the state bridge, initializes the
   states through InitStateDefaults and wires fbStates. FB_Init calls it with the PRG arguments. An FB
   that instantiates FB_IPM inside itself calls it again from its own
   CallAfterInit: the nested FB's CallAfterInit runs before the host's, with
   nil references, so this method has to redo the whole wiring, base included.
   The base holds only references, so the derived type supplies them. *)
METHOD CallAfterInitIPM
VAR_INPUT
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.aiMotionStage         REF= aiMotionStage;
SUPER^.astPositionState      REF= astPositionState;
SUPER^.fbFFHWO               REF= fbFFHWO;
SUPER^.fbArbiter             REF= fbArbiter;
SUPER^.sDeviceName           := sDeviceName;
SUPER^.sTransitionKey        := sTransitionKey;
SUPER^.bEnableBeamParams     := bEnableBeamParams;
SUPER^.bEnablePositionLimits := bEnablePositionLimits;
SUPER^.bReadDBNow            := bReadDBNow;
SUPER^.bFileReaderBusy       REF= bFileReaderBusy;
SUPER^.bFileReaderError      REF= bFileReaderError;

SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;
//
THIS^.InitStateDefaults();
SUPER^.CallAfterInitCore();
]]></ST>
      </Implementation>
    </Method>
    <Property Name="EnumGet" Id="{3025b1b4-6c7e-4d82-8e44-c1c0e3eaf436}">
      <Declaration><![CDATA[(* Current position state. Read-only; written by the state mover. *)
PROPERTY EnumGet : E_IPM_States]]></Declaration>
      <Get Name="Get" Id="{2b9dac6d-9930-4c75-b1b0-911a4b3b17c2}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumGet := eEnumGet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnumSet" Id="{0b7ad22a-1836-4b96-a458-b56e6a6feb81}">
      <Declaration><![CDATA[(* Request a new move, e.g. `fbIPM.EnumSet := E_IPM_States.TARGET1;`.
   The state mover consumes and clears the request. *)
PROPERTY EnumSet : E_IPM_States]]></Declaration>
      <Get Name="Get" Id="{1baa0b43-41f7-4be6-9cab-45720b2ae8e8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumSet := eEnumSet;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{233babf7-d8df-41ad-b39f-281d68239e4b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eEnumSet := EnumSet;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_Init" Id="{c6658695-810e-4456-8ac3-e40b751b3561}">
      <Declaration><![CDATA[(* Repeats the eleven FB_IPM_Core inputs, as a derived FB_Init must, and
   forwards them to CallAfterInitIPM, which provides them to the base, binds
   the state bridge and wires the states. Runs before any CallAfterInit. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains           : BOOL;
    bInCopyCode            : BOOL;
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.CallAfterInitIPM(
    aiMotionStage         := aiMotionStage,
    astPositionState      := astPositionState,
    fbFFHWO               := fbFFHWO,
    fbArbiter             := fbArbiter,
    sDeviceName           := sDeviceName,
    sTransitionKey        := sTransitionKey,
    bEnableBeamParams     := bEnableBeamParams,
    bEnablePositionLimits := bEnablePositionLimits,
    bReadDBNow            := bReadDBNow,
    bFileReaderBusy       := bFileReaderBusy,
    bFileReaderError      := bFileReaderError
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="InitStateDefaults" Id="{751ab5c8-1ffb-48e4-9390-caa44d3369b0}">
      <Declaration><![CDATA[(* Full init of every state of astPositionState: gives it its name (sName) and
   its in-position tolerance (fDelta, FDELTA_DEFAULT) by running afbStateDefaults. astPositionState belongs to the caller, so the
   configurators can only be given the slots once this FB holds the caller's
   reference, and have to run again when a host FB re-wires this one. Returns
   without writing while astPositionState is nil: a nested FB_IPM runs its own
   CallAfterInit before its host has supplied the reference, and indexing a nil
   reference yields an address that passes __ISVALIDREF but faults on the first
   write. *)
METHOD PROTECTED InitStateDefaults
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(THIS^.astPositionState) THEN
    RETURN;
END_IF

afbStateDefaults[1].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_IPM_States.OUT]
);
afbStateDefaults[2].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_IPM_States.TARGET1]
);
afbStateDefaults[3].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_IPM_States.TARGET2]
);
afbStateDefaults[4].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_IPM_States.TARGET3]
);
afbStateDefaults[5].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_IPM_States.TARGET4]
);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>