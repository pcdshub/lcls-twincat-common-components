<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PPM" Id="{21ba0056-420c-4281-af9c-7f35e47eaf5b}" SpecialFunc="None">
    <Declaration><![CDATA[(* Power and Profile Monitor (PPM) with the library state enum E_PPM_States
   (OUT, POWERMETER, YAG1, YAG2): FB_PPM_Core plus the enum bridge, the power
   meter and the per-state defaults. The power-meter calibration and terminal
   range are mandatory FB_Init inputs: fResponsivity (calibrated per gentec; 0
   means the responsive energy is not calculated), iTermBits, fTermMax and
   fTermMin (the defaults 15, 10000 and 0 fit an EL3062; an EL3602 needs
   iTermBits 31 with the range the terminal is configured for). The flow meter
   offset is the FlowOffset property. An FB that nests an FB_PPM calls
   CallAfterInitPPM from its own CallAfterInit. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_PPM EXTENDS FB_PPM_Core
VAR
    (* Device-specific state-enum bridge. Typed as E_PPM_States (UINT
       base); FB_Init binds it to the base's REFERENCE TO UINT
       bridge. EPICS owns it through the pytmc pragma; PLC code
       must go through the EnumSet property instead of touching it
       directly. *)
    // Set this to a non-unknown value to request a new move.
    {attribute 'pytmc' := '
        pv: MMS:STATE:SET
        io: io
    '}
    eEnumSet : E_PPM_States;

    {attribute 'pytmc' := 'pv: SPM'}
    fbPowerMeter : FB_PPM_PowerMeter;

    // Power-meter calibration and terminal range, set through FB_Init.
    fResponsivity : LREAL;
    iTermBits     : UINT;
    fTermMax      : REAL;
    fTermMin      : REAL;

    (* One configurator per PPM state. Writes the per-state sName and fDelta
       once in its CallAfterInit, which InitStateDefaults calls. *)
    afbStateDefaults : ARRAY[1..4] OF FB_CC_InternalStateConfig[
        (stPositionState := astPositionState[1][E_PPM_States.OUT],
         sName           := 'OUT',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_PPM_States.POWERMETER],
         sName           := 'POWERMETER',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_PPM_States.YAG1],
         sName           := 'YAG1',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_PPM_States.YAG2],
         sName           := 'YAG2',
         fDelta          := FDELTA_DEFAULT)
    ];
END_VAR
VAR_OUTPUT
    // The current position state as an enum.
    {attribute 'pytmc' := '
        pv: MMS:STATE:GET
        io: i
    '}
    eEnumGet: E_PPM_States;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();

IF NOT THIS^.ReferencesValid() THEN
    RETURN;
END_IF

// Power meter, temperature FFO vetoed outside POWERMETER.
fbPowerMeter(
    fTempSP      := fbStates.stDbStateParams.stReactiveParams.nTempSP,
    bVetoTempFFO := eEnumGet <> E_PPM_States.POWERMETER,
    sDeviceName  := sDeviceName,
    fbFFHWO      := fbFFHWO,
    eEnumGet     := eEnumGet,
    stYAxisState := aiMotionStage[1].Axis.NcToPlc.AxisState
);]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{fdbf7a93-7d53-46b3-a8dd-92d5bbadf0a1}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init, together with the base CallAfterInit. Binds the
   state bridge to this FB's enum variables and initializes the states. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;

THIS^.InitStateDefaults();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitPPM" Id="{4e388afc-47d9-49b3-800a-9726601ad89e}">
      <Declaration><![CDATA[(* Provides every FB_PPM_Core input, binds the state bridge, initializes the
   states through InitStateDefaults, wires fbStates and configures the power
   meter from the stored calibration. FB_Init calls it with the PRG arguments. An FB
   that instantiates FB_PPM inside itself calls it again from its own
   CallAfterInit: the nested FB's CallAfterInit runs before the host's, with
   nil references, so this method has to redo the whole wiring, base included.
   The base holds only references, so the derived type supplies them. *)
METHOD CallAfterInitPPM
VAR_INPUT
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
    fResponsivity          : LREAL;
    iTermBits              : UINT;
    fTermMax               : REAL;
    fTermMin               : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.aiMotionStage         REF= aiMotionStage;
SUPER^.astPositionState      REF= astPositionState;
SUPER^.fbFFHWO               REF= fbFFHWO;
SUPER^.fbArbiter             REF= fbArbiter;
SUPER^.sDeviceName           := sDeviceName;
SUPER^.sTransitionKey        := sTransitionKey;
SUPER^.bEnableBeamParams     := bEnableBeamParams;
SUPER^.bEnablePositionLimits := bEnablePositionLimits;
SUPER^.bReadDBNow            := bReadDBNow;
SUPER^.bFileReaderBusy       REF= bFileReaderBusy;
SUPER^.bFileReaderError      REF= bFileReaderError;

SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;
//
THIS^.InitStateDefaults();
SUPER^.CallAfterInitCore();

fbPowerMeter.Configure(
    Responsivity := fResponsivity,
    TermBits     := iTermBits,
    TermMax      := fTermMax,
    TermMin      := fTermMin
);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="EnumGet" Id="{afc84f5d-c074-4a10-b242-128e46ae70fb}">
      <Declaration><![CDATA[(* Current position state. Read-only; written by the state mover. *)
PROPERTY EnumGet : E_PPM_States]]></Declaration>
      <Get Name="Get" Id="{ae4a99a0-aa07-40e5-9fe8-f7ccc5bdd67d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumGet := eEnumGet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnumSet" Id="{1506b76c-dd31-480d-bc94-f9f569f83ed4}">
      <Declaration><![CDATA[(* Request a new move, e.g. `fbPPM.EnumSet := E_PPM_States.YAG1;`.
   The state mover consumes and clears the request. *)
PROPERTY EnumSet : E_PPM_States]]></Declaration>
      <Get Name="Get" Id="{55206e57-6826-4a46-bf1e-9668598485f3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumSet := eEnumSet;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{5656aeca-43fb-4c7d-b66c-cf721d261347}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eEnumSet := EnumSet;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_Init" Id="{b7072410-6042-48bb-ba4a-b765b0e46f89}">
      <Declaration><![CDATA[(* Repeats the eleven FB_PPM_Core inputs, as a derived FB_Init must, and
   forwards them to CallAfterInitPPM, which provides them to the base, binds
   the state bridge and wires the states. Runs before any CallAfterInit. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains           : BOOL;
    bInCopyCode            : BOOL;
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
    fResponsivity          : LREAL;
    iTermBits              : UINT;
    fTermMax               : REAL;
    fTermMin               : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.CallAfterInitPPM(
    aiMotionStage         := aiMotionStage,
    astPositionState      := astPositionState,
    fbFFHWO               := fbFFHWO,
    fbArbiter             := fbArbiter,
    sDeviceName           := sDeviceName,
    sTransitionKey        := sTransitionKey,
    bEnableBeamParams     := bEnableBeamParams,
    bEnablePositionLimits := bEnablePositionLimits,
    bReadDBNow            := bReadDBNow,
    bFileReaderBusy       := bFileReaderBusy,
    bFileReaderError      := bFileReaderError,
    fResponsivity         := fResponsivity,
    iTermBits             := iTermBits,
    fTermMax              := fTermMax,
    fTermMin              := fTermMin
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="InitStateDefaults" Id="{f100856c-d13d-4335-bf2b-8c71776cff60}">
      <Declaration><![CDATA[(* Full init of every state of astPositionState: gives it its name (sName) and
   its in-position tolerance (fDelta, FDELTA_DEFAULT) by running afbStateDefaults. astPositionState belongs to the caller, so the
   configurators can only be given the slots once this FB holds the caller's
   reference, and have to run again when a host FB re-wires this one. Returns
   without writing while astPositionState is nil: a nested FB_PPM runs its own
   CallAfterInit before its host has supplied the reference, and indexing a nil
   reference yields an address that passes __ISVALIDREF but faults on the first
   write. *)
METHOD PROTECTED InitStateDefaults
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(THIS^.astPositionState) THEN
    RETURN;
END_IF

afbStateDefaults[1].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_PPM_States.OUT]
);
afbStateDefaults[2].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_PPM_States.POWERMETER]
);
afbStateDefaults[3].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_PPM_States.YAG1]
);
afbStateDefaults[4].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_PPM_States.YAG2]
);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>