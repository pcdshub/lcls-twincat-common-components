<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PneumaticActuator" Id="{2f07bb5c-4a09-4cf3-874c-6ca5c05d35a8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    Pneumatic actuator, single or double acting, ported from the legacy
    FB_MotionPneumaticActuator. Implements I_PneumaticActuator. The limit switch state, the
    insert and retract exclusion and the output timeout come from FB_PneumaticCore, which
    FB_MPA uses as well.

    Position state from the limit switches (in = inserted LS, out = retracted LS):
        in AND out         INVALID
        NOT in AND out     RETRACTED
        in AND NOT out     INSERTED
        NOT in AND NOT out MOVING
    bDone: the commanded direction has reached its limit switch. bBusy: a command
    is active and its limit switch is not reached. xMPS_OK is TRUE only when the
    state is RETRACTED or INSERTED. The fast fault (device 'MPA', type code
    E_MotionFFType.PNEUMATIC_MOVE) trips when xMPS_OK is FALSE.

    Insert and retract requests are mutually exclusive: both set at once clears both.
    Single acting: ibSingleCntrl TRUE and ibCntrlHold TRUE keeps the output on after
    arrival. Double acting: both FALSE, the output drops once the limit switch of the
    commanded direction has been active for LimitSwitchLatchDuration (default 1 s).
    An output that does not reach its limit switch within TimeoutDuration (default
    10 s) sets bError and sErrorMessage until bReset is set.

    Mandatory dependency: the fast fault output is passed through FB_Init as a
    REFERENCE TO (replaces the legacy VAR_IN_OUT io_fbFFHWO). The FB body returns
    while the reference is invalid. When this FB is a member of another FB, the
    enclosing FB passes its own reference in CallAfterInit through
    CallAfterInitActuator.

    VAR_INPUT is kept for the bits driven every cycle by interlocks or the PLC
    program (ibInsertOK, ibRetractOK, ibPMPS_OK, ibSingleCntrl, ibCntrlHold,
    ibOverrideInterlock, i_xReset, i_xAutoReset), so the call style of the legacy
    FB is unchanged. Timeouts are properties. IO members i_xInsertedLS,
    i_xRetractedLS, q_xInsert_DO and q_xRetract_DO keep their names for TcLinkTo.

    Legacy behaviour kept as is: ibPMPS_OK and ibOverrideInterlock are unused (PMPS
    permission is not implemented), and LogEvents (legacy ACT_Logger) is never called by the body.
*)
FUNCTION_BLOCK FB_PneumaticActuator IMPLEMENTS I_PneumaticActuator
VAR_INPUT
    // Actuator can be inserted
    ibInsertOK : BOOL;
    // Actuator can be retracted
    ibRetractOK : BOOL;
    // To be linked to the arbiter bit (unused, as in the legacy FB)
    ibPMPS_OK : BOOL;
    // TRUE if the actuator needs one output (single acting), FALSE if it needs two
    ibSingleCntrl : BOOL;
    // Output must keep its value. TRUE for single acting, FALSE for double acting
    ibCntrlHold : BOOL;
    // If TRUE interlocks are ignored (unused, as in the legacy FB)
    ibOverrideInterlock : BOOL;
    {attribute 'pytmc' := '
    pv: FFO_Reset
    '}
    i_xReset : BOOL;
    {attribute 'pytmc' := '
    pv: FFO_AutoReset
    '}
    i_xAutoReset : BOOL;
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
    pv:
    '}
    stPneumaticActuator : ST_PneumaticActuator;
    {attribute 'pytmc' := '
     pv: MPS_OK
     field: ZNAM FALSE
     field: ONAM TRUE
     field: DESC TRUE if MPS signal is OK
    '}
    xMPS_OK : BOOL;
END_VAR
VAR
    // Fast fault output the fault is raised on
    fbFFHWO : REFERENCE TO FB_HardwareFFOutput;
    // Fault occurs while the actuator is not at a limit switch
    fbFF : FB_FastFault := (
        i_DevName := 'MPA',
        i_Desc := 'Fault occurs when the device is moving',
        i_TypeCode := E_MotionFFType.PNEUMATIC_MOVE);

    ftInit : R_TRIG;
    bFirstPass : BOOL;

    // Shared behaviour of the pneumatic actuator blocks
    fbCore : FB_PneumaticCore;
    // Time an output may stay on without reaching its limit switch
    tTimeOutDuration : TIME := T#10S;
    // Time a limit switch must stay active before a double acting output drops
    tLimitSwitchLatchDuration : TIME := T#1S;
    tonInsertLimitSwitch : TON;
    tonRetractLimitSwitch : TON;

    fbLogger : FB_LogMessage := (eSubsystem := E_SubSystem.MOTION);
    ePrevState : E_PnuematicActuatorPositionState;
    ftAction : R_TRIG;

    i_xInsertedLS AT %I* : BOOL;
    i_xRetractedLS AT %I* : BOOL;
    q_xInsert_DO AT %Q* : BOOL;
    q_xRetract_DO AT %Q* : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT __ISVALIDREF(fbFFHWO) THEN
    RETURN;
END_IF

ftInit(CLK := TRUE, Q => bFirstPass);
IF bFirstPass THEN
    stPneumaticActuator.eState := E_PnuematicActuatorPositionState.INVALID;
    stPneumaticActuator.bRetractCmd := FALSE;
    stPneumaticActuator.bInsertCmd := FALSE;
END_IF

UpdateIO();

// Position state from the limit switches
// The output bits are those of the previous scan, so the timeout is reported one scan late
fbCore(
    bInLimitSwitch := stPneumaticActuator.bInLimitSwitch,
    bOutLimitSwitch := stPneumaticActuator.bOutLimitSwitch,
    bInsertOutput := stPneumaticActuator.bInsertOutput,
    bRetractOutput := stPneumaticActuator.bRetractOutput,
    tTimeout := tTimeOutDuration,
    eState => stPneumaticActuator.eState);

stPneumaticActuator.bDone := (stPneumaticActuator.bRetractCmd AND stPneumaticActuator.eState = E_PnuematicActuatorPositionState.RETRACTED)
    OR (stPneumaticActuator.bInsertCmd AND stPneumaticActuator.eState = E_PnuematicActuatorPositionState.INSERTED);
stPneumaticActuator.bBusy := (stPneumaticActuator.bRetractCmd AND stPneumaticActuator.eState <> E_PnuematicActuatorPositionState.RETRACTED)
    OR (stPneumaticActuator.bInsertCmd AND stPneumaticActuator.eState <> E_PnuematicActuatorPositionState.INSERTED);

// MPS faults when the actuator is in motion
xMPS_OK := (stPneumaticActuator.eState = E_PnuematicActuatorPositionState.RETRACTED)
    OR (stPneumaticActuator.eState = E_PnuematicActuatorPositionState.INSERTED);

// PMPS permission: yet to be implemented

// Insert and retract requests cannot both be active
IF stPneumaticActuator.bInsertCmd AND stPneumaticActuator.bRetractCmd THEN
    stPneumaticActuator.bInsertCmd := FALSE;
    stPneumaticActuator.bRetractCmd := FALSE;
END_IF

// Redundant: clear the opposite output and request when one output is active
IF stPneumaticActuator.bInsertOutput THEN
    stPneumaticActuator.bRetractOutput := FALSE;
    stPneumaticActuator.bRetractCmd := FALSE;
END_IF
IF stPneumaticActuator.bRetractOutput THEN
    stPneumaticActuator.bInsertOutput := FALSE;
    stPneumaticActuator.bInsertCmd := FALSE;
END_IF

stPneumaticActuator.bRetractOutput := stPneumaticActuator.bRetractOK
    AND stPneumaticActuator.bRetractCmd
    AND NOT stPneumaticActuator.bInsertCmd;
stPneumaticActuator.bInsertOutput := stPneumaticActuator.bInsertOK
    AND stPneumaticActuator.bInsertCmd
    AND NOT stPneumaticActuator.bRetractCmd;

// Double acting: drop the output once the actuator is seated in its limit switch
IF NOT ibSingleCntrl AND NOT ibCntrlHold THEN
    IF stPneumaticActuator.bRetractCmd
        AND stPneumaticActuator.bOutLimitSwitch
        AND tonRetractLimitSwitch.Q THEN
        stPneumaticActuator.bRetractOutput := FALSE;
    END_IF
    IF stPneumaticActuator.bInsertCmd
        AND stPneumaticActuator.bInLimitSwitch
        AND tonInsertLimitSwitch.Q THEN
        stPneumaticActuator.bInsertOutput := FALSE;
    END_IF
END_IF

tonInsertLimitSwitch(IN := stPneumaticActuator.bInLimitSwitch, PT := tLimitSwitchLatchDuration);
tonRetractLimitSwitch(IN := stPneumaticActuator.bOutLimitSwitch, PT := tLimitSwitchLatchDuration);

// Moving position timeout
IF fbCore.bInsertTimedOut THEN
    stPneumaticActuator.bError := TRUE;
    stPneumaticActuator.sErrorMessage := 'Actuator insert timeout';
ELSIF fbCore.bRetractTimedOut THEN
    stPneumaticActuator.bError := TRUE;
    stPneumaticActuator.sErrorMessage := 'Actuator retract timeout';
END_IF
stPneumaticActuator.bError R= stPneumaticActuator.bReset;

fbFF(
    i_xOK := xMPS_OK,
    i_xReset := i_xReset,
    i_xAutoReset := i_xAutoReset,
    io_fbFFHWO := fbFFHWO
);

UpdateIO();]]></ST>
    </Implementation>
    <Method Name="UpdateIO" Id="{60848ba4-a65f-4284-9cf1-48a0ecc8af78}">
      <Declaration><![CDATA[(* Soft IO mapping: copies the limit switch inputs into the status struct, the
   command outputs into the digital outputs, and the interlock bits into the
   struct. Runs at the start and end of every body scan. *)
METHOD UpdateIO
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Inputs
stPneumaticActuator.bInLimitSwitch := i_xInsertedLS;
stPneumaticActuator.bOutLimitSwitch := i_xRetractedLS;

// Outputs
q_xInsert_DO := stPneumaticActuator.bInsertOutput;
q_xRetract_DO := stPneumaticActuator.bRetractOutput;

// EPICS
stPneumaticActuator.bRetractOK := ibRetractOK;
stPneumaticActuator.bInsertOK := ibInsertOK;]]></ST>
      </Implementation>
    </Method>
    <Method Name="LogEvents" Id="{13872233-2ed3-4b1f-aa46-893d344f713d}">
      <Declaration><![CDATA[(* Logs timeouts, insert and retract commands and state changes. Kept as in the
   legacy FB: the body does not call it. *)
METHOD LogEvents
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Log timeouts
IF fbCore.InsertTimeoutElapsed OR fbCore.RetractTimeoutElapsed THEN
    fbLogger(
        sMsg := stPneumaticActuator.sErrorMessage,
        eSevr := TcEventSeverity.Warning);
END_IF

// Log actuator commands
ftAction(CLK := stPneumaticActuator.bRetractOutput OR stPneumaticActuator.bInsertOutput);
IF ftAction.Q THEN
    IF stPneumaticActuator.bRetractOutput THEN
        fbLogger(
            sMsg := 'Actuator commanded retract',
            eSevr := TcEventSeverity.Info);
    END_IF
    IF stPneumaticActuator.bInsertOutput THEN
        fbLogger(
            sMsg := 'Actuator commanded insert',
            eSevr := TcEventSeverity.Info);
    END_IF
END_IF

// Log state changes
IF ePrevState <> stPneumaticActuator.eState THEN
    CASE stPneumaticActuator.eState OF
        E_PnuematicActuatorPositionState.INVALID:
            fbLogger(
                sMsg := 'Actuator invalid position.',
                eSevr := TcEventSeverity.Critical);
        E_PnuematicActuatorPositionState.MOVING:
            fbLogger(
                sMsg := 'Actuator moving',
                eSevr := TcEventSeverity.Warning);
        E_PnuematicActuatorPositionState.RETRACTED:
            fbLogger(
                sMsg := 'Actuator Retracted.',
                eSevr := TcEventSeverity.Info);
        E_PnuematicActuatorPositionState.INSERTED:
            fbLogger(
                sMsg := 'Actuator Inserted.',
                eSevr := TcEventSeverity.Info);
    END_CASE
    ePrevState := stPneumaticActuator.eState;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{9bc6d5a9-702c-47e7-8166-1ff1bf1a1058}">
      <Declaration><![CDATA[PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{558243f3-fc44-4d78-977b-d7c698f621b2}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := stPneumaticActuator.bBusy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CallAfterInitActuator" Id="{d4f39575-c492-4742-a42f-29167fd1a19f}">
      <Declaration><![CDATA[(* Rebinds the fast fault output. Call from the CallAfterInit of an enclosing FB. *)
METHOD CallAfterInitActuator
VAR_INPUT
    fbFFHWO : REFERENCE TO FB_HardwareFFOutput;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbFFHWO REF= fbFFHWO;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Done" Id="{53888b0c-796a-4245-8b1e-1dabf8118611}">
