        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Init" Id="{dac1e0fe-6d03-496d-91c2-c314cf683124}">
      <Declaration><![CDATA[(* Stores the mandatory fast fault output at instantiation. *)
METHOD FB_Init : BOOL
VAR_INPUT
    // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInitRetains : BOOL;
    // TRUE: the instance will be copied to the copy code afterward (online change)
    bInCopyCode : BOOL;
    fbFFHWO : REFERENCE TO FB_HardwareFFOutput;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbFFHWO REF= fbFFHWO;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Insert" Id="{a33cb450-2ea7-4a10-9312-12390589f06f}">
      <Declaration><![CDATA[METHOD Insert
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stPneumaticActuator.bInsertCmd := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="LimitSwitchLatchDuration" Id="{15253413-d704-404d-8a3c-d865fc8362d2}">
      <Declaration><![CDATA[// Time a limit switch must stay active before a double acting output drops. Default 1 s
PROPERTY LimitSwitchLatchDuration : TIME]]></Declaration>
      <Get Name="Get" Id="{eb7e98dc-a4e2-43de-bbb8-e9fdbc838711}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
