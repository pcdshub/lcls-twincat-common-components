          <ST><![CDATA[LimitSwitchLatchDuration := tLimitSwitchLatchDuration;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{1c1a16fc-46f8-4b5a-8046-8ea23c898e3b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[tLimitSwitchLatchDuration := LimitSwitchLatchDuration;]]></ST>
        </Implementation>
      </Set>
    </Property>
