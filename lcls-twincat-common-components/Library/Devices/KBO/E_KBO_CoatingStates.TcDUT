{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_KBO_CoatingStates :
(
    Unknown := 0,
    Si := 1,
    B4C := 2
) UINT;
END_TYPE
]]></Declaration>
  </DUT>
