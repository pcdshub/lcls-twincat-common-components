  <DUT Name="E_KBO_CoatingStates" Id="{a3f1b2c4-5d6e-47f8-9a0b-1c2d3e4f5a6b}">
    <Declaration><![CDATA[(* KBO coating-state enum. UINT-typed so REFERENCE TO E_KBO_CoatingStates
