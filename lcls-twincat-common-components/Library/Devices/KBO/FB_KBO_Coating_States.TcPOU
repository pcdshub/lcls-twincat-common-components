<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_KBO_Coating_States" Id="{deb77316-43c4-4f5a-8975-bf0e9f29db7b}" SpecialFunc="None">
    <Declaration><![CDATA[(* KBO mirror coating selector (Si/B4C) with the state enum E_KBO_CoatingStates:
   FB_KBO_Coating_States_Core plus the enum bridge and the per-state defaults.
   FB_Init repeats the core inputs and binds the bridge. Motion dynamics
   (velocity, acceleration) are not applied by this FB; the caller sets them on
   the motor. An FB that nests it calls CallAfterInitKBO from its own
   CallAfterInit. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_KBO_Coating_States EXTENDS FB_KBO_Coating_States_Core
VAR
    // Set this to a non-unknown value to request a new move.
    {attribute 'pytmc' := '
        pv: SET
        io: io
    '}
    eEnumSet : E_KBO_CoatingStates;

    (* One configurator per LIC state (OUT, MIRROR1, MIRROR2, TARGET).*)
    afbStateDefaults : ARRAY[1..2] OF FB_CC_InternalStateConfig[
        (stPositionState := astPositionState[1][E_KBO_CoatingStates.Si],
         sName           := 'Si',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_KBO_CoatingStates.B4C],
         sName           := 'B4C',
         fDelta          := FDELTA_DEFAULT)
    ];
END_VAR
VAR_OUTPUT
    // The current position state as an enum.
    {attribute 'pytmc' := '
        pv: GET
        io: i
    '}
    eEnumGet: E_KBO_CoatingStates;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{17376970-4807-4bb1-b271-e09f05ff2933}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init, together with the base CallAfterInit. Binds the
   state bridge to this FB's enum variables and initializes the states. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;

THIS^.InitStateDefaults();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitKBO" Id="{88a0d026-69e5-41b1-b604-b92688d9bf1d}">
      <Declaration><![CDATA[(* Provides every FB_KBO_Coating_States_Core input, binds the state bridge, initializes the
   states through InitStateDefaults and wires fbStates. FB_Init calls it with the PRG arguments. An FB
   that instantiates FB_KBO_Coating_States inside itself calls it again from its own
   CallAfterInit: the nested FB's CallAfterInit runs before the host's, with
   nil references, so this method has to redo the whole wiring, base included.
   The base holds only references, so the derived type supplies them. *)
METHOD CallAfterInitKBO
VAR_INPUT
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.aiMotionStage         REF= aiMotionStage;
SUPER^.astPositionState      REF= astPositionState;
SUPER^.fbFFHWO               REF= fbFFHWO;
SUPER^.fbArbiter             REF= fbArbiter;
SUPER^.sDeviceName           := sDeviceName;
SUPER^.sTransitionKey        := sTransitionKey;
SUPER^.bEnableBeamParams     := bEnableBeamParams;
SUPER^.bEnablePositionLimits := bEnablePositionLimits;
SUPER^.bReadDBNow            := bReadDBNow;
SUPER^.bFileReaderBusy       REF= bFileReaderBusy;
SUPER^.bFileReaderError      REF= bFileReaderError;

SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;
//
THIS^.InitStateDefaults();
SUPER^.CallAfterInitCore();
]]></ST>
      </Implementation>
    </Method>
    <Property Name="EnumGet" Id="{5a206634-26f1-42ee-a49a-ec79e96530d8}">
      <Declaration><![CDATA[(* Current position state. Read-only; written by the state mover. *)
PROPERTY EnumGet : E_KBO_CoatingStates]]></Declaration>
      <Get Name="Get" Id="{ea20709e-379c-4634-90a1-288c16617369}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumGet := eEnumGet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnumSet" Id="{e1e62db4-5c01-4828-a522-e8b235b4498f}">
      <Declaration><![CDATA[(* Request a new move, e.g. `fbKBO.EnumSet := E_KBO_CoatingStates.B4C;`.
   The state mover consumes and clears the request. *)
PROPERTY EnumSet : E_KBO_CoatingStates]]></Declaration>
      <Get Name="Get" Id="{4c7a9e13-52b8-4d06-a1f3-6e90b2d8c457}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumSet := eEnumSet;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d3b86f21-7a4e-4c95-8e0d-1f5a29c6b784}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eEnumSet := EnumSet;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_Init" Id="{24b70ae3-febe-4a10-a250-16ca093456b8}">
      <Declaration><![CDATA[(* Repeats the eleven FB_KBO_Coating_States_Core inputs, as a derived FB_Init must, and
   forwards them to CallAfterInitKBO, which provides them to the base, binds
   the state bridge and wires the states. Runs before any CallAfterInit. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains           : BOOL;
    bInCopyCode            : BOOL;
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.CallAfterInitKBO(
    aiMotionStage         := aiMotionStage,
    astPositionState      := astPositionState,
    fbFFHWO               := fbFFHWO,
    fbArbiter             := fbArbiter,
    sDeviceName           := sDeviceName,
    sTransitionKey        := sTransitionKey,
    bEnableBeamParams     := bEnableBeamParams,
    bEnablePositionLimits := bEnablePositionLimits,
    bReadDBNow            := bReadDBNow,
    bFileReaderBusy       := bFileReaderBusy,
    bFileReaderError      := bFileReaderError
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="InitStateDefaults" Id="{65876859-1c67-4ceb-a122-5e82d69f06be}">
      <Declaration><![CDATA[(* Full init of every state of astPositionState: gives it its name (sName) and
   its in-position tolerance (fDelta, FDELTA_DEFAULT) by running afbStateDefaults. astPositionState belongs to the caller, so the
   configurators can only be given the slots once this FB holds the caller's
   reference, and have to run again when a host FB re-wires this one. Returns
   without writing while astPositionState is nil: a nested FB_KBO_Coating_States runs its own
   CallAfterInit before its host has supplied the reference, and indexing a nil
   reference yields an address that passes __ISVALIDREF but faults on the first
   write. *)
METHOD PROTECTED InitStateDefaults
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(THIS^.astPositionState) THEN
    RETURN;
END_IF

afbStateDefaults[1].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_KBO_CoatingStates.Si]
);
afbStateDefaults[2].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_KBO_CoatingStates.B4C]
);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>