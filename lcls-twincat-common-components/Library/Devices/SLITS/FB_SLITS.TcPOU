<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SLITS" Id="{e16e0f37-b04b-4e2b-a3f3-e910fdc91095}" SpecialFunc="None">
    <Declaration><![CDATA[(* Four-blade slit aperture controller (Top/Bottom/North/South), ND framework.
   Each blade uses a per-cycle FB_StatePTPMove single-shot mover (targets
   recomputed from EPICS aperture width/center + encoder offsets), not a named
   state mover. Caller-owned stages, PMPS FFO and device name injected via FB_Init
   REFERENCE TO; CallAfterInit wires blade interfaces. Motion parameters
   (velocity/accel/decel/jerk) belong to the caller-owned stage, set once at
   commissioning and persisted; FB_SLITS does not apply them.

   FB_SLITS is the motion-only base of a three-level chain:
   FB_SLITS, FB_SLITS_THERMAL (adds RTDs, flow switch and the reactive
   temperature fault) and FB_SLITS_POWER (adds the PMPS arbiter aperture
   handshake). The body runs the request handling, target calculation and blade
   motion. A changed gap request is accepted without a limit here, as in the
   legacy scatter slits. FB_SLITS_POWER limits it through the M_GapRequestAllowed
   hook. The only PMPS check on the base is the legacy M_CheckPMPS, which a
   device calls instead of FB_SLITS_POWER.M_UpdatePMPS, never both, since they
   drive the same FFO. A device that calls neither runs without aperture
   enforcement. *)
{attribute 'analysis' := '-33'}
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_SLITS
VAR_INPUT
    {attribute 'pytmc' := '
        pv: PMPS_OK
        io: i
        field: ZNAM False
        field: ONAM True
    '}
    bMoveOk : BOOL;

    (* Per-blade encoder zero-offsets (EPICS-settable). *)
    {attribute 'pytmc' := '
        pv: Offset_Top
        io: io
    '}
    rEncoderOffsetTop : REAL;

    {attribute 'pytmc' := '
        pv: ZeroOffset_Bottom
        io: io
    '}
    rEncoderOffsetBottom : REAL;

    {attribute 'pytmc' := '
        pv: ZeroOffset_North
        io: io
    '}
    rEncoderOffsetNorth : REAL;

    {attribute 'pytmc' := '
        pv: ZeroOffset_South
        io: io
    '}
    rEncoderOffsetSouth : REAL;
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
        pv: ACTUAL_XWIDTH
        io: io
    '}
    rActApertureSizeX : REAL;
    {attribute 'pytmc' := '
        pv: ACTUAL_YWIDTH
        io: io
    '}
    rActApertureSizeY : REAL;
    {attribute 'pytmc' := '
        pv: ACTUAL_XCENTER
        io: io
    '}
    rActCenterX : REAL;
    {attribute 'pytmc' := '
        pv: ACTUAL_YCENTER
        io: io
    '}
    rActCenterY : REAL;
END_VAR
VAR CONSTANT
    (* Position-compare deltas for the blade ST_PositionState. *)
    fSmallDelta : LREAL := 0.01;
     (* Reference blade motion tuning (velocity/accel/decel/jerk). Not applied
       here: motion parameters belong to the caller-owned stage, set once at
       commissioning and persisted. Kept as commissioning reference values. *)
    // fVelocity     : LREAL := 0.2;
    // fAcceleration : LREAL := 0.8;
    // fDeceleration : LREAL := 0.8;
    // fJerk         : LREAL := 0.0;
END_VAR
VAR
    // Set when an X or Y move was dispatched this cycle. Read and cleared
    // through ExecuteMotionX and ExecuteMotionY.
    bExecuteMotionX : BOOL;
    bExecuteMotionY : BOOL;

    (* Per-blade scratch ST_PositionState. Static fields seeded here;
       fPosition and bMoveOk are refreshed each cycle in the body. *)
    stTop    : ST_PositionState := (sName := 'Top',    bValid := TRUE, bUseRawCounts := FALSE, fDelta := fSmallDelta);
    stBottom : ST_PositionState := (sName := 'Bottom', bValid := TRUE, bUseRawCounts := FALSE, fDelta := fSmallDelta);
    stNorth  : ST_PositionState := (sName := 'North',  bValid := TRUE, bUseRawCounts := FALSE, fDelta := fSmallDelta);
    stSouth  : ST_PositionState := (sName := 'South',  bValid := TRUE, bUseRawCounts := FALSE, fDelta := fSmallDelta);

    (* Per-blade PTP movers. iMotionStage is wired in CallAfterInit;
       FB_StatePTPMove tolerates a nil interface until then. *)
    {attribute 'pytmc' := 'pv: TOP'}
    fbTop    : FB_StatePTPMove(
        stPositionState := stTop,
        iMotionStage:=0
    );
    {attribute 'pytmc' := 'pv: BOTTOM'}
    fbBottom : FB_StatePTPMove(
        stPositionState := stBottom,
        iMotionStage:=0
    );
    {attribute 'pytmc' := 'pv: NORTH'}
    fbNorth  : FB_StatePTPMove(
        stPositionState := stNorth,
        iMotionStage:=0
    );
    {attribute 'pytmc' := 'pv: SOUTH'}
    fbSouth  : FB_StatePTPMove(
        stPositionState := stSouth,
        iMotionStage:=0
    );

    (* Aperture-math intermediate targets. *)
    fPosTopBlade    : LREAL;
    fPosBottomBlade : LREAL;
    fPosNorthBlade  : LREAL;
    fPosSouthBlade  : LREAL;

    (* EPICS request / actual aperture geometry. *)
    {attribute 'pytmc' := '
        pv: XWID_REQ
        io: io
    '}
    rReqApertureSizeX : REAL;
    {attribute 'pytmc' := '
        pv: YWID_REQ
        io: io
    '}
    rReqApertureSizeY : REAL;
    {attribute 'pytmc' := '
        pv: XCEN_REQ
        io: io
    '}
    rReqCenterX : REAL;
    {attribute 'pytmc' := '
        pv: YCEN_REQ
        io: io
    '}
    rReqCenterY : REAL;


    (* Edge-trigger request flags. Cleared on the rising edge each
       cycle but no preset move is dispatched (stub: legacy parity). *)
    {attribute 'pytmc' := '
        pv: OPEN
        io: io
        field: ZNAM False
        field: ONAM True
    '}
    bOpen : BOOL;

    {attribute 'pytmc' := '
        pv: CLOSE
        io: io
        field: ZNAM False
        field: ONAM True
    '}
    bClose : BOOL;

    {attribute 'pytmc' := '
        pv: BLOCK
        io: io
        field: ZNAM False
        field: ONAM True
    '}
    bBlock : BOOL;

    rTrig_Block : R_TRIG;
    rTrig_Open  : R_TRIG;
    rTrig_Close : R_TRIG;

    (* Change-detection latches for EPICS request fields. *)
    rOldReqApertureSizeX : REAL;
    rOldReqApertureSizeY : REAL;
    rOldReqCenterX       : REAL;
    rOldReqCenterY       : REAL;


    fbLogger : FB_LogMessage := (eSubsystem := E_SubSystem.MOTION);

    (* PMPS aperture-safety fault, driven by M_CheckPMPS here or by
       FB_SLITS_POWER.M_UpdatePMPS. A device calls at most one of them. *)
    FFO : FB_FastFault := (
        i_DevName  := sDeviceName,
        i_Desc     := 'Fault occurs when gaps and/or centers are not within safe margins, or PMPS mode is switched OFF',
        i_TypeCode := 16#FAA
    );

    (* Sanitizers for the PMPS aperture read by M_CheckPMPS from
       PMPS_GVL.stCurrentBeamParameters.astApertures. Gated on bBridgeOK only:
       that data has no xOK flag. *)
    fbCheckAptWidth  : FB_FallibleRealFromEtherCAT(tHeartbeatExpirationTime := T#1S);
    fbCheckAptHeight : FB_FallibleRealFromEtherCAT(tHeartbeatExpirationTime := T#1S);

    (* REF backing fields, populated by FB_Init. *)
    {attribute 'no_copy'}
    aiMotionStage : REFERENCE TO ARRAY[1..4] OF I_MotionStage;
    {attribute 'no_copy'}
    fbFFHWO       : REFERENCE TO FB_HardwareFFOutput;

    (* Arbiter bridge (PMPS_PRE) health: connection up and inbound data valid,
       the bBridgeOk output of the FB_SubSysToArbiter_IO the caller runs. The
       astApertures data read by M_CheckPMPS (and AptArrayReq in FB_SLITS_POWER)
       is untrustworthy while FALSE. A mandatory FB_Init input. *)
    {attribute 'no_copy'}
    bBridgeOK : REFERENCE TO BOOL;
    sDeviceName   :  STRING;
    nMotor : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT __ISVALIDREF(THIS^.aiMotionStage)
   OR NOT __ISVALIDREF(THIS^.fbFFHWO)
   OR NOT __ISVALIDREF(THIS^.bBridgeOK) THEN
    RETURN;
END_IF

HandleRequests();
M_CalculatePositions();
M_Motion();
]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{2bf5a8b9-6045-4972-b69a-4ac8a54c0162}">
      <Declaration><![CDATA[(* Auto-fired once after FB_Init binds the REFs. Wires the four blade movers through
   CallAfterInitCore. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.CallAfterInitCore();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitCore" Id="{5c344acd-53fe-4568-a37d-fdc6f668c333}">
      <Declaration><![CDATA[(* The four FB_StatePTPMove blade movers were inline-init'd with nil interface refs,
   so this re-supplies each blade's now-valid interface and scratch
   ST_PositionState, and sets the FFO device name. Does nothing while the
   motion stages or the fast-fault output are still nil, as when this FB is
   nested and its own CallAfterInit runs before its host has supplied them. A
   derived type calls it again through SUPER^ after a re-wire. *)
METHOD PROTECTED CallAfterInitCore
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(aiMotionStage)
   OR NOT __ISVALIDREF(fbFFHWO)
   OR NOT __ISVALIDREF(bBridgeOK) THEN
    RETURN;
END_IF

fbTop.CallAfterInit(
    stPositionState := stTop,
    iMotionStage    := aiMotionStage[E_SlitsBlade.TOP]
);
fbBottom.CallAfterInit(
    stPositionState := stBottom,
    iMotionStage    := aiMotionStage[E_SlitsBlade.BOTTOM]
);
fbNorth.CallAfterInit(
    stPositionState := stNorth,
    iMotionStage    := aiMotionStage[E_SlitsBlade.NORTH]
);
fbSouth.CallAfterInit(
    stPositionState := stSouth,
    iMotionStage    := aiMotionStage[E_SlitsBlade.SOUTH]
);

FFO.i_DevName := sDeviceName;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitSLITS" Id="{e50a065e-166b-42d0-b7e8-cdb420182ed3}">
      <Declaration><![CDATA[(* Provides every FB_SLITS FB_Init input and wires the blade movers. FB_Init and
   the derived re-wire methods call it. An FB that nests a slit calls the
   re-wire method of its type from its own CallAfterInit: the nested slit's
   CallAfterInit runs before the host's, with nil references, so the re-wire
   redoes the whole wiring. *)
METHOD CallAfterInitSLITS
VAR_INPUT
    aiMotionStage : REFERENCE TO ARRAY[1..4] OF I_MotionStage;
    fbFFHWO       : REFERENCE TO FB_HardwareFFOutput;
    sDeviceName   : STRING;
    bBridgeOK     : REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.aiMotionStage REF= aiMotionStage;
THIS^.fbFFHWO       REF= fbFFHWO;
THIS^.sDeviceName   := sDeviceName;
THIS^.bBridgeOK     REF= bBridgeOK;
fbCheckAptWidth.sName    := CONCAT(sDeviceName, ' PMPS check width');
fbCheckAptHeight.sName   := CONCAT(sDeviceName, ' PMPS check height');

THIS^.CallAfterInitCore();
]]></ST>
      </Implementation>
    </Method>
    <Property Name="ExecuteMotionX" Id="{703122b2-8000-4680-898b-c49b95a6bafb}">
      <Declaration><![CDATA[(* TRUE when a X move was dispatched and not yet consumed by M_Motion. *)
PROPERTY ExecuteMotionX : BOOL]]></Declaration>
      <Get Name="Get" Id="{ae6b853c-5f7c-4ab6-b72e-c8580982709e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecuteMotionX := bExecuteMotionX;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{28545f93-e59a-4cbf-bf00-29572024a6cd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bExecuteMotionX := ExecuteMotionX;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ExecuteMotionY" Id="{deb16891-ef96-4536-a032-ca2c8403fa4d}">
      <Declaration><![CDATA[(* TRUE when a Y move was dispatched and not yet consumed by M_Motion. *)
PROPERTY ExecuteMotionY : BOOL]]></Declaration>
      <Get Name="Get" Id="{a90a8f10-3966-4fab-8ed2-1d372b85e0f5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecuteMotionY := bExecuteMotionY;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{e231be8e-a045-47cc-9a72-5c6c3841a134}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bExecuteMotionY := ExecuteMotionY;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_Init" Id="{e16e0f37-b04b-4e2b-a3f3-e910fdc91097}">
      <Declaration><![CDATA[(* REF-binds caller-owned aiMotionStage (4 blades), fbFFHWO and sDeviceName
   at instantiation and names the M_CheckPMPS input sanitizers. Blade interface
   wiring runs from CallAfterInit once these REFs are bound. Derived types
   append their own parameters after these. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains  : BOOL;
    bInCopyCode   : BOOL;
    aiMotionStage : REFERENCE TO ARRAY[1..4] OF I_MotionStage;
    fbFFHWO       : REFERENCE TO FB_HardwareFFOutput;
    sDeviceName   : STRING;
    bBridgeOK     : REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.CallAfterInitSLITS(
    aiMotionStage := aiMotionStage,
    fbFFHWO       := fbFFHWO,
    sDeviceName   := sDeviceName,
    bBridgeOK     := bBridgeOK
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="HandleRequests" Id="{e16e0f37-b04b-4e2b-a3f3-e910fdc91099}">
      <Declaration><![CDATA[(*
    Consume the EPICS Open / Close / Block rising-edge requests and
    self-clear the flags. No preset move is dispatched (legacy stub).
*)
METHOD HandleRequests
]]></Declaration>
      <Implementation>
        <ST><![CDATA[rTrig_Block(CLK := bBlock);
rTrig_Open(CLK := bOpen);
rTrig_Close(CLK := bClose);

IF rTrig_Block.Q THEN
    bBlock := FALSE;
END_IF
IF rTrig_Open.Q THEN
    bOpen := FALSE;
END_IF
IF rTrig_Close.Q THEN
    bClose := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CalculatePositions" Id="{e16e0f37-b04b-4e2b-a3f3-e910fdc9109a}">
      <Declaration><![CDATA[(* Legacy ACT_CalculatePositions equivalent. Runs M_PreCalculate, then detects
   EPICS request changes (a changed gap is accepted only when
   M_GapRequestAllowed returns TRUE, which the base always does), recomputes
   per-blade targets from requested gap + center + encoder offset, and refreshes
   actual aperture geometry feedback from caller-owned motor positions. *)
METHOD M_CalculatePositions
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_PreCalculate();

IF rOldReqApertureSizeX <> rReqApertureSizeX THEN
    IF M_GapRequestAllowed(eAxis := E_SlitsAxis.X, fSize := rReqApertureSizeX) THEN
        rOldReqApertureSizeX := rReqApertureSizeX;
        bExecuteMotionX      := TRUE;
        fbLogger(sMsg := 'Requested new X gap.', eSevr := TcEventSeverity.Verbose);
    ELSE
        fbLogger(
            sMsg := 'Requested new X gap is larger than PMPS request.',
            eSevr := TcEventSeverity.Verbose
        );
    END_IF
END_IF

IF rOldReqCenterX <> rReqCenterX THEN
    rOldReqCenterX  := rReqCenterX;
    bExecuteMotionX := TRUE;
    fbLogger(sMsg := 'Requested new X center', eSevr := TcEventSeverity.Verbose);
END_IF

IF rOldReqApertureSizeY <> rReqApertureSizeY THEN
    IF M_GapRequestAllowed(eAxis := E_SlitsAxis.Y, fSize := rReqApertureSizeY) THEN
        rOldReqApertureSizeY := rReqApertureSizeY;
        bExecuteMotionY      := TRUE;
        fbLogger(sMsg := 'Requested new Y gap.', eSevr := TcEventSeverity.Verbose);
    ELSE
        fbLogger(
            sMsg := 'Requested new Y gap is larger than PMPS request.',
            eSevr := TcEventSeverity.Verbose
        );
    END_IF
END_IF

IF rOldReqCenterY <> rReqCenterY THEN
    rOldReqCenterY  := rReqCenterY;
    bExecuteMotionY := TRUE;
    fbLogger(sMsg := 'Requested new Y center.', eSevr := TcEventSeverity.Verbose);
END_IF

// Blade targets from gap, centre and encoder offset.
fPosTopBlade    :=  (rReqApertureSizeY / 2) + (rReqCenterY + rEncoderOffsetTop);
fPosBottomBlade := -(rReqApertureSizeY / 2) + (rReqCenterY + rEncoderOffsetBottom);
fPosNorthBlade  :=  (rReqApertureSizeX / 2) + (rReqCenterX + rEncoderOffsetNorth);
fPosSouthBlade  := -(rReqApertureSizeX / 2) + (rReqCenterX + rEncoderOffsetSouth);

// Actual aperture geometry feedback from caller-owned motors.
rActApertureSizeX := LREAL_TO_REAL(
    (aiMotionStage[E_SlitsBlade.NORTH].MotionStatus.fActPosition - rEncoderOffsetNorth)
  - (aiMotionStage[E_SlitsBlade.SOUTH].MotionStatus.fActPosition - rEncoderOffsetSouth)
);
rActApertureSizeY := LREAL_TO_REAL(
    (aiMotionStage[E_SlitsBlade.TOP].MotionStatus.fActPosition    - rEncoderOffsetTop)
  - (aiMotionStage[E_SlitsBlade.BOTTOM].MotionStatus.fActPosition - rEncoderOffsetBottom)
);
rActCenterX := LREAL_TO_REAL(
    ((aiMotionStage[E_SlitsBlade.NORTH].MotionStatus.fActPosition - rEncoderOffsetNorth)
   + (aiMotionStage[E_SlitsBlade.SOUTH].MotionStatus.fActPosition - rEncoderOffsetSouth)) / 2
);
rActCenterY := LREAL_TO_REAL(
    ((aiMotionStage[E_SlitsBlade.TOP].MotionStatus.fActPosition    - rEncoderOffsetTop)
   + (aiMotionStage[E_SlitsBlade.BOTTOM].MotionStatus.fActPosition - rEncoderOffsetBottom)) / 2
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckPMPS" Id="{2340e24c-17b3-4b83-9a88-189f8479d873}">
      <Declaration><![CDATA[(* Legacy PMPS aperture check from the per-PLC FB_SLITS copies (SL1K3, SL1K4).
         Faults the FFO from a comparison of the actual gaps with
         PMPS_GVL.stCurrentBeamParameters.astApertures[index] plus 0.001. The
         comparison is unchanged. The only addition is input protection: each
         aperture value goes through FB_FallibleRealFromEtherCAT, which holds the
         last good value while the arbiter bridge is down (bBridgeOK) or the
         reading is NaN/Inf. With a healthy bridge and finite data it behaves as
         deployed. It does not use a PMPS mode switch or an arbiter request, and does
         not write AptArrayStatus. FFO is shared with
         FB_SLITS_POWER.M_UpdatePMPS, so a device calls at most one of the two
         methods. *)
METHOD M_CheckPMPS : BOOL
VAR_INPUT
    index : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT M_ReadApertures(index) THEN
    RETURN;
END_IF

IF (rActApertureSizeX < (fbCheckAptWidth.fValue + 0.001))
   OR (rActApertureSizeY < (fbCheckAptHeight.fValue + 0.001)) THEN
    FFO.i_xOK := FALSE;
ELSE
    FFO.i_xOK := TRUE;
END_IF

FFO(
    i_xAutoReset := TRUE,
    io_fbFFHWO   := fbFFHWO
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GapRequestAllowed" Id="{2a05db71-9396-4967-bef6-5bfdb104a47f}">
      <Declaration><![CDATA[(* Hook called by M_CalculatePositions when the requested gap of one axis
   changed. Returns TRUE when the request may be accepted and dispatched, FALSE
   to reject it (M_CalculatePositions then logs that the gap is larger than the
   PMPS request and keeps the previous request). The base accepts every gap, as
   the legacy scatter slits do. FB_SLITS_POWER overrides it to enforce the
   trusted PMPS aperture. *)
METHOD PROTECTED M_GapRequestAllowed : BOOL
VAR_INPUT
    eAxis : E_SlitsAxis;
    fSize : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_GapRequestAllowed := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Motion" Id="{e16e0f37-b04b-4e2b-a3f3-e910fdc9109b}">
      <Declaration><![CDATA[(* Legacy ACT_Motion equivalent. Refreshes per-blade ST_PositionState
   fPosition/bMoveOk, asserts bExecute on each FB_StatePTPMove on aperture
   change (self-clears on arrival/error, so re-dispatch waits for completion),
   and ticks the four blade movers cyclically. *)
METHOD M_Motion
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stTop.fPosition    := fPosTopBlade;
stTop.bMoveOk      := bMoveOk;

stBottom.fPosition := fPosBottomBlade;
stBottom.bMoveOk   := bMoveOk;

stNorth.fPosition  := fPosNorthBlade;
stNorth.bMoveOk    := bMoveOk;

stSouth.fPosition  := fPosSouthBlade;
stSouth.bMoveOk    := bMoveOk;

IF bExecuteMotionY THEN
    fbTop.bExecute    := TRUE;
    fbBottom.bExecute := TRUE;
END_IF
IF bExecuteMotionX THEN
    fbNorth.bExecute := TRUE;
    fbSouth.bExecute := TRUE;
END_IF
bExecuteMotionX := FALSE;
bExecuteMotionY := FALSE;

fbTop(bMoveOk    := bMoveOk);
fbBottom(bMoveOk := bMoveOk);
fbNorth(bMoveOk  := bMoveOk);
fbSouth(bMoveOk  := bMoveOk);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PreCalculate" Id="{a3e4e09f-d550-48c4-807f-8e0076a8a1e4}">
      <Declaration><![CDATA[(* Hook called once at the start of every M_CalculatePositions, before any
   request is compared. Empty in the base. FB_SLITS_POWER overrides it to
   refresh the trusted PMPS aperture that M_GapRequestAllowed reads. *)
METHOD PROTECTED M_PreCalculate
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetActualAperture" Id="{8c1932a8-5257-408a-9d5a-55fd95d3da8a}">
      <Declaration><![CDATA[(* Test seam: overwrite the measured aperture (gap and center) that the body
   normally derives from the blade positions. The values are outputs, so
   tests that call M_CheckPMPS or M_UpdatePMPS directly set them here. *)
METHOD INTERNAL SetActualAperture
VAR_INPUT
    ApertureSizeX : REAL;
    ApertureSizeY : REAL;
    CenterX       : REAL;
    CenterY       : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[rActApertureSizeX := ApertureSizeX;
rActApertureSizeY := ApertureSizeY;
rActCenterX       := CenterX;
rActCenterY       := CenterY;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetApertureRequest" Id="{e16e0f37-b04b-4e2b-a3f3-e910fdc9109d}">
      <Declaration><![CDATA[(* Set the EPICS aperture request in one call: gap (width/height) and center
   on both axes. M_CalculatePositions picks the values up next cycle and, if a
   field changed and M_GapRequestAllowed accepts the gap, dispatches the moves. *)
METHOD SetApertureRequest
VAR_INPUT
    ApertureSizeX : REAL;
    ApertureSizeY : REAL;
    CenterX       : REAL;
    CenterY       : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[rReqApertureSizeX := ApertureSizeX;
rReqApertureSizeY := ApertureSizeY;
rReqCenterX       := CenterX;
rReqCenterY       := CenterY;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ReadApertures" Id="{45d6134a-6758-49f2-8fc2-38eec061839d}">
      <Declaration><![CDATA[(* The one place the PMPS aperture of this slit is read from
   PMPS_GVL.stCurrentBeamParameters.astApertures. Each value goes through
   FB_FallibleRealFromEtherCAT, which holds the last good value while the arbiter
   bridge is down (bBridgeOK) or the reading is NaN or infinite, so no comparison
   or division sees a raw bridge value. A comparison with NaN stops the PLC.
   Returns FALSE and reads nothing when index is outside astApertures or the
   bridge reference is still nil. M_CheckPMPS and
   FB_SLITS_POWER.M_UpdatePMPS read the sanitized width and height through
   fbCheckAptWidth.fValue and fbCheckAptHeight.fValue after calling it. *)
METHOD PROTECTED M_ReadApertures : BOOL
VAR_INPUT
    index : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_ReadApertures := index >= 1
                  AND index <= UINT_TO_INT(PMPS_GVL.MAX_APERTURES)
                  AND __ISVALIDREF(bBridgeOK);
IF NOT M_ReadApertures THEN
    RETURN;
END_IF

fbCheckAptWidth(
    i_bBridgeOk := bBridgeOK,
    i_fValue    := PMPS_GVL.stCurrentBeamParameters.astApertures[index].Width
);
fbCheckAptHeight(
    i_bBridgeOk := bBridgeOK,
    i_fValue    := PMPS_GVL.stCurrentBeamParameters.astApertures[index].Height
);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>