<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SLITS_POWER" Id="{f2a7b61c-c24f-40b8-8c2e-4d94fdfd3c86}" SpecialFunc="None">
    <Declaration><![CDATA[(* Power-class slit: FB_SLITS_THERMAL (motion, RTDs, flow switch, reactive
   temperature fault) plus the PMPS arbiter aperture handshake. AptArrayReq
   carries the arbiter aperture request in, AptArrayStatus reports the actual
   geometry out. The request is sanitized into rTrustedAptWidth/Height
   (bridge health, xOK, finite values) and gates operator gap requests through
   the M_GapRequestAllowed override. M_PreCalculate refreshes that trusted
   aperture at the start of every M_CalculatePositions. The integrator calls
   M_UpdatePMPS each cycle for the status mirror, the fault and the snap-back.
   FFO is shared with FB_SLITS.M_CheckPMPS, so call at most one of the two. *)
{attribute 'analysis' := '-33'}
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_SLITS_POWER EXTENDS FB_SLITS_THERMAL
VAR_INPUT
    {attribute 'pytmc' := '
		pv: MODE
		field: ZNAM Local
		field: ONAM PMPS
		io: io
    '}
    xPMPSMode : BOOL := TRUE;
END_VAR
VAR
    (* TRUE only once the bridge is confirmed bad, not while an unconfirmed
       zero reading is still inside the debounce window. Gates the FFO trip. The
       bBridgeConfirmedBad output of the FB_SubSysToArbiter_IO the caller runs, a
       mandatory FB_Init input. *)
    {attribute 'no_copy'}
    bBridgeConfirmedBad : REFERENCE TO BOOL;
    (* PMPS aperture IO (caller-mapped to terminals). *)
    AptArrayStatus AT %Q* : ST_PMPS_Aperture_IO;
    AptArrayReq    AT %I* : ST_PMPS_Aperture_IO;

    (* PMPS sanitizers for the raw AptArrayReq Width/Height. Each holds the last
       trusted value while the bridge/xOK is untrusted or the reading is
       NaN/Inf. Operator gap requests and the PMPS aperture limit use the
       outputs below, so a stale or invalid request never loosens the limit. *)
    fbTrustedAptWidth  : FB_FallibleRealFromEtherCAT(tHeartbeatExpirationTime := T#1S);
    fbTrustedAptHeight : FB_FallibleRealFromEtherCAT(tHeartbeatExpirationTime := T#1S);
    rTrustedAptWidth  : REAL;
    rTrustedAptHeight : REAL;
    // TRUE when bBridgeOK AND AptArrayReq.xOK.
    bAptTrusted   : BOOL;
    bOverAperture : BOOL;
    rBadXOK       : R_TRIG;

    (* Margin (mm) subtracted from the authorized width/height when snapping
       the request into PMPS compliance. Set via FB_Init, defaults to 0.01. *)
    fApertureMargin : REAL := 0.01;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{44b9d57e-287b-4bfc-a956-ba6b8f11b210}">
      <Declaration><![CDATA[(* Records fApertureMargin and names the trusted-aperture sanitizers;
   aiMotionStage, fbFFHWO, sDeviceName, sPmpsState and bFileReaderBusy are
   handled by the base FB_Init methods. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains  : BOOL;
    bInCopyCode   : BOOL;
    aiMotionStage : REFERENCE TO ARRAY[1..4] OF I_MotionStage;
    fbFFHWO       : REFERENCE TO FB_HardwareFFOutput;
    sDeviceName   : STRING;
    bBridgeOK       : REFERENCE TO BOOL;
    sPmpsState    : STRING;
    bFileReaderBusy : REFERENCE TO BOOL;
    fApertureMargin : REAL;
    bBridgeConfirmedBad : REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.CallAfterInitPOWER(
    aiMotionStage   := aiMotionStage,
    fbFFHWO         := fbFFHWO,
    sDeviceName     := sDeviceName,
    bBridgeOK       := bBridgeOK,
    sPmpsState      := sPmpsState,
    bFileReaderBusy := bFileReaderBusy,
    fApertureMargin := fApertureMargin,
    bBridgeConfirmedBad := bBridgeConfirmedBad
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitPOWER" Id="{c487e3da-7571-4622-ae6d-7ad241316e77}">
      <Declaration><![CDATA[(* Provides every FB_SLITS_POWER FB_Init input, through the FB_SLITS_THERMAL
   re-wire. An FB that nests an FB_SLITS_POWER calls it from its own
   CallAfterInit. *)
METHOD CallAfterInitPOWER
VAR_INPUT
    aiMotionStage   : REFERENCE TO ARRAY[1..4] OF I_MotionStage;
    fbFFHWO         : REFERENCE TO FB_HardwareFFOutput;
    sDeviceName     : STRING;
    bBridgeOK       : REFERENCE TO BOOL;
    sPmpsState      : STRING;
    bFileReaderBusy : REFERENCE TO BOOL;
    fApertureMargin : REAL;
    bBridgeConfirmedBad : REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.CallAfterInitTHERMAL(
    aiMotionStage   := aiMotionStage,
    fbFFHWO         := fbFFHWO,
    sDeviceName     := sDeviceName,
    bBridgeOK       := bBridgeOK,
    sPmpsState      := sPmpsState,
    bFileReaderBusy := bFileReaderBusy
);

THIS^.bBridgeConfirmedBad REF= bBridgeConfirmedBad;
THIS^.fApertureMargin := fApertureMargin;
fbTrustedAptWidth.sName  := CONCAT(sDeviceName, ' aperture width');
fbTrustedAptHeight.sName := CONCAT(sDeviceName, ' aperture height');
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GapRequestAllowed" Id="{83c3aac7-96e2-4b13-bed6-5d2b94cd48dc}">
      <Declaration><![CDATA[(* Accepts a changed gap request only when it does not exceed the trusted
   PMPS aperture width (X) or height (Y). Reads rTrustedAptWidth/Height, which
   M_PreCalculate refreshed earlier in the same cycle. *)
METHOD PROTECTED M_GapRequestAllowed : BOOL
VAR_INPUT
    eAxis : E_SlitsAxis;
    fSize : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eAxis = E_SlitsAxis.X THEN
    M_GapRequestAllowed := fSize <= rTrustedAptWidth;
ELSE
    M_GapRequestAllowed := fSize <= rTrustedAptHeight;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PreCalculate" Id="{c0b82c7a-873f-43b8-95de-98d6f4b70386}">
      <Declaration><![CDATA[(* Refreshes the trusted PMPS aperture before M_CalculatePositions compares
   any request against it. *)
METHOD PROTECTED M_PreCalculate
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_UpdateAptTrust();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdatePMPS" Id="{ca5ec8cc-d21a-4bab-9ab7-cefd0c187d48}">
      <Declaration><![CDATA[(* Integrator-driven PMPS aperture-safety reconciliation, called each cycle
   with index = this device's slot in astApertures. Mirrors actual geometry
         into AptArrayStatus. The authorized envelope is the last aperture request
         received while the arbiter bridge was healthy and xOK was TRUE
         (rTrustedAptWidth/Height). Faults FFO when the actual gap exceeds that
         envelope, on a confirmed bridge failure, or always in Local mode. In PMPS
         mode it also snaps the request into compliance. An untrusted request
         (xOK FALSE) is logged and ignored. Reads the slit's PMPS aperture through M_ReadApertures, so an index outside
         astApertures returns without writing anything and the width and height checked
         below are sanitized. FFO is shared with FB_SLITS.M_CheckPMPS, so a device
   calls at most one of the two methods. *)
METHOD M_UpdatePMPS : BOOL
VAR_INPUT
    index : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT M_ReadApertures(index) THEN
    RETURN;
END_IF

IF NOT __ISVALIDREF(bBridgeOK) OR NOT __ISVALIDREF(bBridgeConfirmedBad) THEN
    RETURN;
END_IF

// Mirror current actual aperture geometry and any-blade error state.
THIS^.AptArrayStatus.Height := THIS^.rActApertureSizeY;
THIS^.AptArrayStatus.Width  := THIS^.rActApertureSizeX;
THIS^.AptArrayStatus.xOK    :=
        NOT (THIS^.aiMotionStage[E_SlitsBlade.TOP   ].MotionStatus.bError)
    AND NOT (THIS^.aiMotionStage[E_SlitsBlade.BOTTOM].MotionStatus.bError)
    AND NOT (THIS^.aiMotionStage[E_SlitsBlade.NORTH ].MotionStatus.bError)
    AND NOT (THIS^.aiMotionStage[E_SlitsBlade.SOUTH ].MotionStatus.bError);

// Aperture-envelope evaluation against the last trusted PMPS request.
M_UpdateAptTrust();

bOverAperture :=
    ( THIS^.rActApertureSizeX > (rTrustedAptWidth  - (2 * ABS(THIS^.rActCenterX)))
      AND fbCheckAptWidth.fValue  > 0 )
 OR ( THIS^.rActApertureSizeY > (rTrustedAptHeight - (2 * ABS(THIS^.rActCenterY)))
      AND fbCheckAptHeight.fValue > 0 );

rBadXOK(CLK := bBridgeOK AND NOT AptArrayReq.xOK AND NOT bBridgeConfirmedBad);

IF bBridgeConfirmedBad OR NOT xPMPSMode THEN
    // Confirmed bridge failure, or Local mode: always fault.
    FFO.i_xOK := FALSE;
ELSIF bBridgeOK AND NOT AptArrayReq.xOK THEN
    // Untrusted request: hold the last trusted limit and do not act on it.
    FFO.i_xOK := NOT bOverAperture;
    IF rBadXOK.Q THEN
        fbLogger(
            sMsg  := 'PMPS aperture request xOK FALSE, ignoring untrusted request.',
            eSevr := TcEventSeverity.Warning
        );
    END_IF
ELSIF bBridgeOK THEN
    FFO.i_xOK := NOT bOverAperture;
    IF THIS^.rActApertureSizeX > rTrustedAptWidth THEN
        rReqApertureSizeX := rTrustedAptWidth - fApertureMargin;
    END_IF
    IF THIS^.rActApertureSizeY > rTrustedAptHeight THEN
        rReqApertureSizeY := rTrustedAptHeight - fApertureMargin;
    END_IF
END_IF
// PMPS mode with the bridge down but not yet confirmed bad: FFO.i_xOK keeps its last value.

FFO(
    i_xAutoReset := TRUE,
    io_fbFFHWO   := fbFFHWO
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateAptTrust" Id="{c2a19fb7-5699-4cb0-a912-605d406f11b1}">
      <Declaration><![CDATA[(* Refreshes bAptTrusted and sanitizes the PMPS aperture request into
         rTrustedAptWidth/Height via FB_FallibleRealFromEtherCAT: the request is taken
         only while the bridge is healthy, xOK is TRUE and the value is finite. A stale,
         invalid or NaN/Inf request keeps the last good limit.
         Idempotent, so both M_PreCalculate and M_UpdatePMPS call it. *)
METHOD INTERNAL M_UpdateAptTrust
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bAptTrusted := bBridgeOK AND AptArrayReq.xOK;
fbTrustedAptWidth(i_bBridgeOk := bAptTrusted, i_fValue := AptArrayReq.Width);
fbTrustedAptHeight(i_bBridgeOk := bAptTrusted, i_fValue := AptArrayReq.Height);
rTrustedAptWidth  := fbTrustedAptWidth.fValue;
rTrustedAptHeight := fbTrustedAptHeight.fValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAptRequest" Id="{3b9d6e41-8c2f-4a75-b1d0-6e47a2c9f813}">
      <Declaration><![CDATA[(* Drives the AT %I* aperture request, which cannot be written from outside
   the FB. Used by simulation and tests. *)
METHOD INTERNAL SetAptRequest
VAR_INPUT
    Width  : REAL;
    Height : REAL;
    xOK    : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.AptArrayReq.Width  := Width;
THIS^.AptArrayReq.Height := Height;
THIS^.AptArrayReq.xOK    := xOK;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAptWidthHeight" Id="{60fd3513-e7c9-401c-93aa-fb77211506a9}">
      <Declaration><![CDATA[METHOD INTERNAL SetAptWidthHeight
VAR_INPUT
    Width : REAL;
    Height : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.AptArrayReq.Width := Width;
THIS^.AptArrayReq.Height := Height;
THIS^.AptArrayReq.xOK := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>