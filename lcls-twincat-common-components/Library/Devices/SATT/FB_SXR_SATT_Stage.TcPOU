<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SXR_SATT_Stage" Id="{7fb611c7-2215-4e8f-8a28-e51a98acae9a}" SpecialFunc="None">
    <Declaration><![CDATA[(* Single Solid Attenuator (SATT) with the state enum E_SXR_SATT_Position:
   FB_SXR_SATT_Stage_Core plus the enum bridge. FB_Init repeats the core inputs
   and binds the bridge. An FB that nests it calls CallAfterInitSATT from its own
   CallAfterInit. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_SXR_SATT_Stage EXTENDS FB_SXR_SATT_Stage_Core
VAR
    (* Device-specific state-enum bridge. Typed as E_SXR_SATT_Position (UINT
       base); FB_Init binds it to the base's REFERENCE TO UINT bridge. EPICS
       owns it through the pytmc pragma; PLC code must go through the EnumSet
       property instead of touching it directly. *)
    // Set this to a non-unknown value to request a new move.
    {attribute 'pytmc' := '
        pv: STATE:SET
        io: io
    '}
    eEnumSet : E_SXR_SATT_Position;
END_VAR
VAR_OUTPUT
    // The current position state as an enum.
    {attribute 'pytmc' := '
        pv: STATE:GET
        io: i
    '}
    eEnumGet : E_SXR_SATT_Position;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{7b24db72-0a11-4684-90b0-d961df314b26}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init, together with the base CallAfterInit. Binds the
   state bridge to this FB's enum variables. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitSATT" Id="{0a892a5e-4395-4077-842b-3c3be3afe42b}">
      <Declaration><![CDATA[(* Provides every FB_SXR_SATT_Stage_Core input, binds the state bridge and wires
   fbStates. FB_Init calls it with the PRG arguments. An FB that instantiates
   this FB inside itself calls it again from its own CallAfterInit: the nested
   FB's CallAfterInit runs before the host's, with nil references, so this
   method redoes the whole wiring, base included. *)
METHOD CallAfterInitSATT
VAR_INPUT
    aiMotionStage    : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                          OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    bFileReaderBusy  : REFERENCE TO BOOL;
    bBridgeOK        : REFERENCE TO BOOL;
    fbFFHWO          : REFERENCE TO FB_HardwareFFOutput;
    sDeviceName      : STRING;
    RTDPMPSState     : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.aiMotionStage    REF= aiMotionStage;
SUPER^.astPositionState REF= astPositionState;
SUPER^.fbFFHWO          REF= fbFFHWO;
SUPER^.bFileReaderBusy  REF= bFileReaderBusy;
SUPER^.bBridgeOK        REF= bBridgeOK;
SUPER^.sDeviceName      := sDeviceName;
SUPER^.RTDPMPSState     := RTDPMPSState;

SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;

SUPER^.CallAfterInitCore();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{6a5f30fa-9fa8-46e8-806a-36fee4d5a223}">
      <Declaration><![CDATA[(* Repeats the core inputs, as a derived FB_Init must, and forwards them to
   CallAfterInitSATT. Runs before any CallAfterInit. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains     : BOOL;
    bInCopyCode      : BOOL;
    aiMotionStage    : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                          OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    bFileReaderBusy  : REFERENCE TO BOOL;
    bBridgeOK        : REFERENCE TO BOOL;
    fbFFHWO          : REFERENCE TO FB_HardwareFFOutput;
    sDeviceName      : STRING;
    RTDPMPSState     : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.CallAfterInitSATT(
    aiMotionStage    := aiMotionStage,
    astPositionState := astPositionState,
    bFileReaderBusy  := bFileReaderBusy,
    bBridgeOK        := bBridgeOK,
    fbFFHWO          := fbFFHWO,
    sDeviceName      := sDeviceName,
    RTDPMPSState     := RTDPMPSState
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="EnumGet" Id="{176f7c09-c56c-42e7-b20a-6b0da2f13387}">
      <Declaration><![CDATA[(* Current position state. Read-only; written by the state mover. *)
PROPERTY EnumGet : E_SXR_SATT_Position]]></Declaration>
      <Get Name="Get" Id="{63dfefc0-6337-4760-bade-4056669f937c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumGet := eEnumGet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnumSet" Id="{b7616b49-7981-48ca-aef7-a43b09424e67}">
      <Declaration><![CDATA[(* Request a new move, e.g. `fbSATT.EnumSet := E_SXR_SATT_Position.FILTER1;`.
   The state mover consumes and clears the request. *)
PROPERTY EnumSet : E_SXR_SATT_Position]]></Declaration>
      <Get Name="Get" Id="{5da9a31e-56f3-40ba-b74f-384ca8163935}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumSet := eEnumSet;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{60c02dbe-7fb8-4781-abdf-ebabce3efb88}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eEnumSet := EnumSet;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>
