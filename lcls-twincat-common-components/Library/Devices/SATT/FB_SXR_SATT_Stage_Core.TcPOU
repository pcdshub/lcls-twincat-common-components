<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SXR_SATT_Stage_Core" Id="{aa980bf2-5805-4912-97a2-b3037a355869}" SpecialFunc="None">
    <Declaration><![CDATA[(* Single Solid Attenuator (SATT) core, an abstract base by convention: filter
   stack (L2SI compact, 4 stacks of 8 filters), single-axis mover via
   FB_PositionStateND (states OUT, FILTER1..FILTER8). Holds only references, the
   filter table input and the sub-FBs. Not a PMPS state mover; only RTD reactive-temp
   fault thresholds and a "device moving" fast fault. Per-cycle transmission from
   filter material/thickness and beam energy, computed only for a positive
   energy because F_CalculateAbsorptionConstant divides by it (a zero energy
   stops the PLC). The RTD reactive temperature is read from the device-level
   DB key RTDPMPSState, which must exist (its temperature may be blank),
   because the filters are not PMPS states. The state bridge is here as
   REFERENCE TO UINT (eEnumSetRef and eEnumGetRef) and the body runs on it, but
   the enum variables belong to the derived type (FB_SXR_SATT_Stage), which
   passes them in. The derived body calls SUPER^() to run this logic, so the FB
   cannot carry no_explicit_call. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_SXR_SATT_Stage_Core
VAR_INPUT
    (* Per-filter material / thickness table, written by FB_SATT_FilterConfig
       through a slot reference. Used by the transmission calculation. Index 1
       corresponds to FILTER1 (which is the state at slot 2 in astPositionState,
       since OUT lives at slot 1 in E_SXR_SATT_Position). *)
    {attribute 'pytmc' := 'pv: FILTERS'}
    arrFilters : ARRAY[1..8] OF ST_SATT_Filter;
END_VAR
VAR_OUTPUT
    fTemp1                    : LREAL;
    fTemp2                    : LREAL;
    bIsStationary             : BOOL;
    bError                    : BOOL;
    {attribute 'pytmc' := '
        pv: MATERIAL
        io: i
    '}
    sActiveFilterMaterial     : STRING;

    {attribute 'pytmc' := '
        pv: THICKNESS
        io: i
        field: EGU um
    '}
    fActiveFilterThickness_um : LREAL;

    {attribute 'pytmc' := '
        pv: TRANSMISSION
        io: i
        field: DESC Filter transmission
    '}
    fTransmission             : LREAL;
    fActiveFilterDensity      : LREAL;
    fActiveFilterAtomicMass   : LREAL;
    fAbsorptionConstant       : LREAL;

    iFilterIndex              : INT := 0;
END_VAR
VAR
    (* State bridge, bound by the derived type to its enum variables. *)
    {attribute 'no_copy'}
    eEnumSetRef : REFERENCE TO UINT;
    {attribute 'no_copy'}
    eEnumGetRef : REFERENCE TO UINT;

    fbStates : FB_PositionStateND(
        aiMotionStage        := aiMotionStage,
        astPositionState     := astPositionState,
        nActiveMotorCount    := nStateMotorCount,
        eEnumSet             := eEnumSetRef,
        eEnumGet             := eEnumGetRef,
        bEnableMotion        := bEnableMotion,
        eMotionRequestPolicy := E_MotionRequestPolicy.INTERRUPT
    );

    (* Photon energy from the arbiter bridge, sanitized the way the slit apertures
       are: it holds the last good value while the bridge is down (bBridgeOK) or
       the reading is NaN or infinite. bBridgeOK is the arbiter bridge health, the
       bBridgeOk output of the FB_SubSysToArbiter_IO the caller runs. *)
    {attribute 'no_copy'}
    bBridgeOK : REFERENCE TO BOOL;
    fbPhotonEnergy : FB_FallibleRealFromEtherCAT(tHeartbeatExpirationTime := T#1S);

    fbAtomicMass               : FB_AtomicMass;
    fbAttenuatorElementDensity : FB_AttenuatorElementDensity;

    (* EL3202-0020: 0.01 deg C per digit. Vetoed when the stage is in
       OUT (no filter in beam, no temperature to monitor). *)
    {attribute 'pytmc' := 'pv: RTD:1'}
    fbRTD_1 : FB_CC_TempSensor := (fResolution := 0.01);
    {attribute 'pytmc' := 'pv: RTD:2'}
    fbRTD_2 : FB_CC_TempSensor := (fResolution := 0.01);

    bFileReaderBusy       : REFERENCE TO BOOL;
    (* JSON DB read for the currently active filter's
       PMPS state, just to pull the reactive temp setpoint into
       astPickedDB[1].stReactiveParams.nTempSP. Not a PMPS BPTM
       participant; just borrows the DB pipeline. *)
    fbReadPMPSDB : FB_JsonDocToSafeBP;
    astPickedDB  : ARRAY[1..1] OF ST_DbStateParams;

    (* "Device is moving" fast fault. Raised while the Y motor is
       moving or while we are sitting in UNKNOWN. *)
    fbFF : FB_FastFault := (
        i_Desc       := 'Device is moving',
        i_TypeCode   := E_MotionFFType.DEVICE_MOVE,
        i_xAutoReset := TRUE
    );

    {attribute 'no_copy'}
    aiMotionStage    : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    {attribute 'no_copy'}
    astPositionState : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                          OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    {attribute 'no_copy'}
    fbFFHWO          : REFERENCE TO FB_HardwareFFOutput;
    sDeviceName      : STRING;
    (* PMPS DB key for the RTD reactive-temperature read. The filters are not real PMPS states,
        so this device-level key names the DB entry to pull the reactive temp setpoint from.
    *)
    RTDPMPSState     : STRING;
    bEnableMotion    : BOOL := TRUE;
END_VAR
VAR CONSTANT
    (* Number of motors the state mover drives. Every device here has one state
       motor, in slot 1; the code around fbStates assumes it. *)
    nStateMotorCount : UINT := 1;
    // State values of the E_SXR_SATT_Position enum: UNKNOWN must be 0, OUT is 1.
    nUnknownState : UINT := 0;
    nOutState     : UINT := 1;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT __ISVALIDREF(aiMotionStage)
   OR NOT __ISVALIDREF(astPositionState)
   OR NOT __ISVALIDREF(fbFFHWO)
   OR NOT __ISVALIDREF(bBridgeOK)
   OR NOT __ISVALIDREF(eEnumSetRef)
   OR NOT __ISVALIDREF(eEnumGetRef) THEN
    RETURN;
END_IF

fbStates();

fbPhotonEnergy(
    i_bBridgeOk := bBridgeOK,
    i_fValue    := PMPS_GVL.stCurrentBeamParameters.neV
);

// FILTER1..8 are slots 2..9; OUT is slot 1.
iFilterIndex := UINT_TO_INT(eEnumGetRef) - 1;

IF iFilterIndex >= 1 AND iFilterIndex <= 8 THEN
    sActiveFilterMaterial     := arrFilters[iFilterIndex].sFilterMaterial;
    fActiveFilterThickness_um := arrFilters[iFilterIndex].fFilterThickness_um;

    fbAtomicMass(
        sName  := sActiveFilterMaterial,
        fValue => fActiveFilterAtomicMass
    );
    fbAttenuatorElementDensity(
        sName    := sActiveFilterMaterial,
        fDensity => fActiveFilterDensity
    );

    // A zero energy divides by zero, so it is skipped.
    IF fbPhotonEnergy.fValue > 0 THEN
        fAbsorptionConstant := F_CalculateAbsorptionConstant(
            sElement      := sActiveFilterMaterial,
            fEnergyEV     := fbPhotonEnergy.fValue,
            fDensity_gm3  := fActiveFilterDensity,
            fAtomicWeight := fActiveFilterAtomicMass,
            bError        => bError
        );
        fTransmission := F_CalculateTransmission(
            fAbsorptionConstant := fAbsorptionConstant,
            fThickness_in_m     := fActiveFilterThickness_um * 1.0E-6
        );
    ELSE
        fAbsorptionConstant := 0.0;
        fTransmission       := 1.0;
        bError              := FALSE;
    END_IF
ELSE
    sActiveFilterMaterial     := '';
    fActiveFilterThickness_um := 0.0;
    fAbsorptionConstant       := 0.0;
    fActiveFilterDensity      := 0.0;
    fActiveFilterAtomicMass   := 0.0;
    fTransmission             := 1.0;
END_IF

// Moving fault: stationary and a known position.
bIsStationary := NOT aiMotionStage[1].Axis.Status.Moving;
fbFF(
    i_DevName  := sDeviceName,
    i_xOK      := bIsStationary AND eEnumGetRef <> nUnknownState,
    io_fbFFHWO := fbFFHWO
);

// RTD limit comes from the device-level key RTDPMPSState.
astPickedDB[1].sPmpsState := RTDPMPSState;

fbReadPMPSDB(
    bExecute    := NOT bFileReaderBusy,
    jsonDoc     := PMPS_GVL.BP_jsonDoc,
    sDeviceName := sDeviceName,
    arrStates   := astPickedDB,
    io_fbFFHWO  := fbFFHWO
);

fbRTD_1(
    fFaultThreshold := astPickedDB[1].stReactiveParams.nTempSP,
    sDevName        := sDeviceName,
    bVeto           := eEnumGetRef = nOutState,
    io_fbFFHWO      := fbFFHWO
);
fTemp1 := fbRTD_1.fTemp;

fbRTD_2(
    fFaultThreshold := astPickedDB[1].stReactiveParams.nTempSP,
    sDevName        := sDeviceName,
    bVeto           := eEnumGetRef = nOutState,
    io_fbFFHWO      := fbFFHWO
);
fTemp2 := fbRTD_2.fTemp;]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{f9500b7f-59f1-4b7f-845d-3d260be0cfcb}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init. Wires fbStates through CallAfterInitCore. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.CallAfterInitCore();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitCore" Id="{402aa473-8ecc-4b0d-b476-99758a6ae129}">
      <Declaration><![CDATA[(* Re-supplies the references this FB holds to fbStates through
   CallAfterInitStateMover, because fbStates' inline-init ran first and
   forwarded nil refs. Does nothing while a reference is still nil. A derived
   type that was re-wired after its host FB's CallAfterInit calls it again
   through SUPER^. *)
METHOD PROTECTED CallAfterInitCore
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(aiMotionStage)
   OR NOT __ISVALIDREF(astPositionState)
   OR NOT __ISVALIDREF(eEnumSetRef)
   OR NOT __ISVALIDREF(eEnumGetRef) THEN
    RETURN;
END_IF

fbPhotonEnergy.sName := CONCAT(sDeviceName, ' photon energy');

THIS^.fbStates.CallAfterInitStateMover(
    aiMotionStage         := aiMotionStage,
    astPositionState      := astPositionState,
    nActiveMotorCount     := nStateMotorCount,
    eEnumSet              := eEnumSetRef,
    eEnumGet              := eEnumGetRef,
    bEnableMotion         := bEnableMotion,
    eMotionRequestPolicy  := E_MotionRequestPolicy.INTERRUPT,
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{4d009fc5-e22a-45ec-94c1-75b9ef8e38f7}">
      <Declaration><![CDATA[(* Stores the injected references and values. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains     : BOOL;
    bInCopyCode      : BOOL;
    aiMotionStage    : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                          OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    bFileReaderBusy  : REFERENCE TO BOOL;
    bBridgeOK        : REFERENCE TO BOOL;
    fbFFHWO          : REFERENCE TO FB_HardwareFFOutput;
    sDeviceName      : STRING;
    RTDPMPSState     : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.aiMotionStage    REF= aiMotionStage;
THIS^.astPositionState REF= astPositionState;
THIS^.fbFFHWO          REF= fbFFHWO;
THIS^.bFileReaderBusy  REF= bFileReaderBusy;
THIS^.bBridgeOK        REF= bBridgeOK;
THIS^.sDeviceName      := sDeviceName;
THIS^.RTDPMPSState     := RTDPMPSState;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>